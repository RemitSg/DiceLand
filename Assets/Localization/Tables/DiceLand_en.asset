  - m_Id: 22781564105032
    m_Localized: "Black Coffin \xD71"
    m_Metadata:
      m_Items: []
  - m_Id: 22781564105033
    m_Localized: Ocean Current
    m_Metadata:
      m_Items: []
  - m_Id: 22781564105034
    m_Localized: "Ocean Current \xD71"
    m_Metadata:
