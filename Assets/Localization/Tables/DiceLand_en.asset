  - m_Id: 22781564105041
    m_Localized: Headwind Ranger
    m_Metadata:
      m_Items: []
  - m_Id: 22781564105042
    m_Localized: "Headwind Ranger \xD71"
    m_Metadata:
      m_Items: []
