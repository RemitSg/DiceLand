    m_Localized: Wire Puppet
    m_Metadata:
      m_Items: []
  - m_Id: 22781564105044
    m_Localized: "Wire Puppet \xD71"
    m_Metadata:
      m_Items: []
  - m_Id: 22781564105045
    m_Localized: Mirror Bearer
    m_Metadata:
