    m_Metadata:
      m_Items: []
  - m_Id: 22781576687738
    m_Localized: Investment
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687739
    m_Localized: 'The company manager smiled and handed me a little contract that
      he could not read.


      "This is the true quality of the project."'
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687740
