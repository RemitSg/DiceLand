      m_Items: []
  - m_Id: 22781576687971
    m_Localized: "\u4F60\u4FE1\u5FC3\u6EE1\u6EE1\uFF0C\u628A\u4F60\u80FD\u60F3\u5230\u7684\u4E1C\u897F\u9012\u7ED9\u4E86\u5973\u5DEB\uFF0C\u5973\u5DEB\u63A5\u8FC7\u6765\u4E00\u770B\uFF0C\u6447\u4E86\u6447\u5934\uFF1A\u201C\u4F60\u8FD9\u8BA9\u6211\u600E\u4E48\u653E\u5FC3\uFF1F\u6CA1\u6709\u90A3\u4E9B\u4E1C\u897F\uFF0C\u4F60\u51FA\u53BB\u4E0D\u5149\u5BB3\u4EBA\u8FD8\u5BB3\u5DF1\uFF0C\u7ED9\u6211\u56DE\u53BB\u91CD\u65B0\u5F04\uFF01\u201D\r\n\r\n\u5979\u98DE\u8D77\u4E00\u811A\u628A\u4F60\u8E39\u56DE\u4E86\u76E5\u6D17\u5BA4\uFF0C\u8FD9\u6B21\u7531\u4E8E\u98DE\u5F97\u592A\u8FDC\uFF0C\u4F60\u7684\u5C41\u80A1\u6454\u6210\u4E86\u516D\u5341\u56DB\u74E3\u3002\r\n\r\n\u4F60\u6B32\u54ED\u65E0\u6CEA\uFF1A\u201C\u771F\u662F\u6CA1\u5B8C\u6CA1\u4E86\u4E86\u2026\u2026\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687972
    m_Localized: "\u65B0\u624B\u6559\u7A0B"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687973
    m_Localized: "\u901A\u8FC7\u7AE0\u8282\u603B\u89C8\u5FEB\u901F\u4E86\u89E3\u5730\u56FE\u63A8\u8FDB\u3001\u6218\u6597\u64CD\u4F5C\u4E0E\u6210\u957F\u7CFB\u7EDF\u3002\u5F53\u524D\u7248\u672C\u5148\u63D0\u4F9B\u4E3B\u83DC\u5355\u6559\u7A0B\u4E2D\u5FC3\u5165\u53E3\u4E0E\u5185\u5BB9\u9AA8\u67B6\uFF0C\u540E\u7EED\u53EF\u4EE5\u7EE7\u7EED\u6269\u5C55\u7AE0\u8282\u72B6\u6001\u3001\u5206\u6B65\u6307\u5F15\u3001\u5B8C\u6210\u5EA6\u8BB0\u5F55\u548C\u8DF3\u8F6C\u903B\u8F91\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687974
    m_Localized: "\u5F00\u59CB\u6559\u7A0B"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687975
    m_Localized: "\u8FD4\u56DE\u4E3B\u83DC\u5355"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687976
    m_Localized: "\u6559\u7A0B\u603B\u89C8"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687977
    m_Localized: "\u5148\u7406\u89E3\u6574\u4F53\u6D41\u7A0B\uFF0C\u77E5\u9053\u540E\u7EED\u4F1A\u8986\u76D6\u5730\u56FE\u3001\u6218\u6597\u3001\u6210\u957F\u4E0E\u8D44\u6E90\u7BA1\u7406\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687978
    m_Localized: "\u672C\u7AE0\u8282\u7528\u4E8E\u627F\u63A5\u4E3B\u83DC\u5355\u5165\u53E3\uFF0C\u672A\u6765\u53EF\u6269\u5C55\u4E3A\u7AE0\u8282\u7D22\u5F15\u3001\u5B8C\u6210\u5EA6\u6458\u8981\u548C\u63A8\u8350\u6E38\u73A9\u987A\u5E8F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687979
    m_Localized: "\u5DF2\u5C31\u7EEA"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687980
    m_Localized: "\u5730\u56FE\u63A8\u8FDB"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687981
    m_Localized: "\u8BA4\u8BC6\u8282\u70B9\u8DEF\u7EBF\u3001\u5173\u952E\u623F\u95F4\u4E0E\u63A8\u8FDB\u8282\u594F\uFF0C\u5E2E\u52A9\u7B2C\u4E00\u6B21\u8FDB\u5165\u5730\u56FE\u65F6\u5FEB\u901F\u5EFA\u7ACB\u65B9\u5411\u611F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687982
    m_Localized: "\u540E\u7EED\u53EF\u63A5\u5165\u56FA\u5B9A\u8DEF\u7EBF\u3001\u5730\u56FE\u63D0\u793A\u548C\u6559\u5B66\u8282\u70B9\u9AD8\u4EAE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687983
    m_Localized: "\u5DF2\u89C4\u5212"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687984
    m_Localized: "\u6218\u6597\u57FA\u7840"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687985
    m_Localized: "\u5B66\u4F1A\u9009\u4E2D\u6280\u80FD\u3001\u8FDE\u63A5\u76EE\u6807\u3001\u5904\u7406\u78B0\u649E\u4E0E\u5355\u65B9\u9762\u653B\u51FB\u7B49\u6838\u5FC3\u64CD\u4F5C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687986
    m_Localized: "\u540E\u7EED\u53EF\u63A5\u5165\u6218\u6597\u5185\u5206\u6B65\u9650\u5236\u3001\u63D0\u793A\u6D6E\u5C42\u548C\u5931\u8D25\u91CD\u8BD5\u68C0\u67E5\u70B9\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687987
    m_Localized: "\u5DF2\u89C4\u5212"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687988
    m_Localized: "\u6210\u957F\u4E0E\u517B\u6210"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687989
    m_Localized: "\u4E86\u89E3\u6B66\u5668\u3001\u89D2\u8272\u6210\u957F\u3001\u6062\u590D\u4E0E\u5F3A\u5316\u4E4B\u95F4\u7684\u5173\u7CFB\uFF0C\u5EFA\u7ACB\u957F\u671F\u63A8\u8FDB\u8BA4\u77E5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687990
    m_Localized: "\u540E\u7EED\u53EF\u6269\u5C55\u4E3A\u88C5\u5907\u66F4\u6362\u3001\u8D44\u6E90\u6D88\u8017\u4E0E\u6536\u76CA\u5BF9\u6BD4\u6559\u5B66\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687991
    m_Localized: "\u6269\u5C55\u9884\u7559"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687992
    m_Localized: "\u7CFB\u7EDF\u8FDB\u9636"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687993
    m_Localized: "\u4E3A\u72B6\u6001\u8BCD\u3001\u5546\u5E97\u3001\u953B\u9020\u3001\u4E8B\u4EF6\u548C\u9AD8\u96BE\u673A\u5236\u9884\u7559\u72EC\u7ACB\u7AE0\u8282\u7A7A\u95F4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687994
    m_Localized: "\u5F53\u524D\u5148\u4F5C\u4E3A\u5360\u4F4D\u4FE1\u606F\u533A\uFF0C\u540E\u7EED\u53EF\u4EE5\u6309\u6A21\u5757\u62C6\u5206\u6210\u591A\u4E2A\u72EC\u7ACB\u4E13\u9898\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687995
    m_Localized: "\u9884\u7559\u6269\u5C55"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687996
    m_Localized: "\u8BF7\u5148\u70B9\u51FB\u654C\u4EBA\u7684\u672C\u4F53\uFF0C\u67E5\u770B\u654C\u4EBA\u8BE6\u60C5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687997
    m_Localized: "\u8BF7\u5148\u70B9\u51FB\u51C6\u5907\u6309\u94AE\uFF0C\u8FDB\u5165\u672C\u56DE\u5408\u7684\u76EE\u6807\u6307\u5B9A\u9636\u6BB5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687998
    m_Localized: "\u8BF7\u70B9\u51FB\u654C\u4EBA\u7684\u901F\u5EA6\u6309\u94AE\uFF0C\u67E5\u770B\u654C\u4EBA\u6280\u80FD\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576687999
    m_Localized: "\u8BF7\u5148\u67E5\u770B\u654C\u4EBA\u901F\u5EA6\u6309\u94AE\u4E0A\u7684\u6280\u80FD\uFF0C\u518D\u70B9\u51FB\u51C6\u5907\u6309\u94AE\u5F00\u59CB\u7ED3\u7B97\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688000
    m_Localized: "\u51C6\u5907\u53CD\u51FB"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688001
    m_Localized: "\u654C\u4EBA\u7684\u653B\u51FB\u5DF2\u7ECF\u7ED3\u675F\uFF0C\u4E0B\u4E00\u56DE\u5408\u8F6E\u5230\u6211\u4EEC\u4E3B\u52A8\u5904\u7406\u5B83\u3002\n\n\u518D\u6B21\u70B9\u51FB\u51C6\u5907\u6309\u94AE\uFF0C\u751F\u6210\u65B0\u4E00\u56DE\u5408\u7684\u901F\u5EA6\u6309\u94AE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688002
    m_Localized: "\u8BF7\u5148\u70B9\u51FB\u51C6\u5907\u6309\u94AE\uFF0C\u751F\u6210\u65B0\u4E00\u56DE\u5408\u7684\u901F\u5EA6\u6309\u94AE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688003
    m_Localized: "\u8BF7\u70B9\u51FB\u53CB\u65B9\u89D2\u8272\u7684\u901F\u5EA6\u6309\u94AE\uFF0C\u67E5\u770B\u53CB\u65B9\u6280\u80FD\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688004
    m_Localized: "\u8BF7\u62D6\u62FD\u53CB\u65B9\u901F\u5EA6\u6309\u94AE\uFF0C\u8FDE\u5230\u654C\u4EBA\u7684\u901F\u5EA6\u6309\u94AE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688005
    m_Localized: "\u8BF7\u5148\u5B8C\u6210\u8FDE\u7EBF\uFF0C\u518D\u70B9\u51FB\u51C6\u5907\u6309\u94AE\u5F00\u59CB\u62FC\u70B9\u7ED3\u7B97\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688006
    m_Localized: "不好！"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688007
    m_Localized: "看样子 Molly 已经残血了，先点击准备按钮。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688008
    m_Localized: "\u8BF7\u5148\u70B9\u51FB\u51C6\u5907\u6309\u94AE\uFF0C\u751F\u6210\u672C\u56DE\u5408\u7684\u901F\u5EA6\u6309\u94AE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688009
    m_Localized: "观察战场"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688010
    m_Localized: "点击敌人的速度按钮，看看它准备用什么技能。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688011
    m_Localized: "\u8BF7\u5148\u70B9\u51FB\u654C\u4EBA\u7684\u901F\u5EA6\u6309\u94AE\uFF0C\u67E5\u770B\u65A9\u6740\u7684\u76EE\u6807\u504F\u597D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688012
    m_Localized: "危机"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688013
    m_Localized: "不好，斩杀会优先攻击血量最低的目标。现在 Molly 只有 1 点生命，如果不处理，她很可能会被击倒。\n点击 Molly 的速度按钮，查看她能不能自己挡住这次攻击。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688014
    m_Localized: "请点击 Molly 的速度按钮，查看技能。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688015
    m_Localized: "展开拼点"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688016
    m_Localized: "Molly 的轻击最多只能投出 2 点，而敌人的斩杀威力是 2 - 4。直接让 Molly 接上去并不可靠。\n先拖拽 Molly 的速度按钮连到敌人的速度按钮。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688017
    m_Localized: "\u8BF7\u5148\u7528 Molly \u7684\u901F\u5EA6\u6309\u94AE\u8FDE\u5230\u654C\u4EBA\u7684\u901F\u5EA6\u6309\u94AE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688018
    m_Localized: "支援"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688019
    m_Localized: "别忘了我们还有另一名友方角色。\n点击 Chara 的速度按钮，看看他有什么技能可以用。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688020
    m_Localized: "请点击 Chara 的速度按钮。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688021
    m_Localized: "接管拼点"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688022
    m_Localized: "守护是一个防御技能，适合拿来拦截敌人的攻击。\n因为 Chara 的速度更高，可以把敌人的目标从残血 Molly 转移到自己身上。\n用 Chara 的速度按钮连到敌人的速度按钮。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688023
    m_Localized: "\u8BF7\u7528 Chara \u7684\u901F\u5EA6\u6309\u94AE\u8FDE\u5230\u654C\u4EBA\u7684\u901F\u5EA6\u6309\u94AE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688024
    m_Localized: "\u5F00\u59CB\u7ED3\u7B97"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688025
    m_Localized: "注意到了吗？敌人的斩杀原本会找血量最低的 Molly，但现在目标已经被更快的 Chara 接走。\n熟练运用高速度角色的技能拉取目标，可以在关键时刻保护脆弱队友。\n现在点击准备按钮进行结算。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688026
    m_Localized: "\u8BF7\u5148\u5B8C\u6210\u5B88\u62A4\u8FDE\u7EBF\uFF0C\u518D\u70B9\u51FB\u51C6\u5907\u6309\u94AE\u5F00\u59CB\u7ED3\u7B97\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688027
    m_Localized: "准备"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688028
    m_Localized: "先点击准备按钮，生成本回合的速度按钮。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688029
    m_Localized: "\u8BF7\u5148\u70B9\u51FB\u51C6\u5907\u6309\u94AE\uFF0C\u751F\u6210\u672C\u56DE\u5408\u7684\u901F\u5EA6\u6309\u94AE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688030
    m_Localized: "查看技能"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688031
    m_Localized: "从现在开始，友方角色的技能选择应该成为决策的一部分。\n点击我方角色的速度按钮，看清当前有哪些技能、它们分别消耗多少能量、适合用来做什么。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688032
    m_Localized: "\u5148\u70B9\u5F00\u6211\u65B9\u6280\u80FD\u5217\u8868\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688033
    m_Localized: "切换技能"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688034
    m_Localized: "请主动切换一次技能。\n强力技能通常会消耗更多能量。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688035
    m_Localized: "\u5148\u5207\u6362\u4E00\u6B21\u6280\u80FD\uFF0C\u518D\u7EE7\u7EED\u64CD\u4F5C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688036
    m_Localized: "能耗"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688037
    m_Localized: "队伍的能量是共享的，因此需要仔细考虑应该让谁打出强力的技能，谁来负责能量的续航，保存更多能量。\n能量默认会在每回合开始时回复 1 点。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688038
    m_Localized: "\u8BF7\u7528\u4E00\u62DB\u4F1A\u6D88\u8017\u80FD\u91CF\u7684\u6280\u80FD\u5B8C\u6210\u8FDE\u7EBF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688039
    m_Localized: "\u6CE8\u610F\u6280\u80FD\u8BF4\u660E\u91CC\u7684\u4E09\u79CD\u524D\u7F00\u8BCD\u6761"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688040
    m_Localized: "\u73B0\u5728\u4F60\u9700\u8981\u4E86\u89E3\u4E09\u4E2A\u8BCD\u6761\u4E2D\u6700\u91CD\u8981\u7684\u5173\u952E\u8BCD\uFF1A\n\n[\u4F7F\u7528\u65F6]\uFF1A\u53EA\u8981\u8FD9\u62DB\u5F00\u59CB\u7ED3\u7B97\u5C31\u4F1A\u751F\u6548\u3002\n[\u62FC\u70B9\u65F6]\uFF1A\u53EA\u6709\u771F\u6B63\u8FDB\u5165\u62FC\u70B9\u65F6\u624D\u4F1A\u751F\u6548\u3002\n[\u5355\u65B9\u9762\u653B\u51FB\u65F6]\uFF1A\u53EA\u6709\u6CA1\u6709\u62FC\u70B9\u3001\u76F4\u63A5\u6253\u51FA\u53BB\u65F6\u624D\u4F1A\u751F\u6548\u3002\n\n\u70B9\u5F00\u6211\u65B9\u6280\u80FD\u8BF4\u660E\uFF0C\u628A\u4E09\u79CD\u524D\u7F00\u8BCD\u6761\u90FD\u770B\u4E00\u904D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688041
    m_Localized: "\u5148\u67E5\u770B\u6211\u65B9\u6280\u80FD\u8BF4\u660E\uFF0C\u5206\u6E05\u4E09\u79CD\u6280\u80FD\u8BCD\u6761\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688042
    m_Localized: "\u6309\u4F60\u7684\u8BA1\u5212\u5207\u6280\u80FD"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688043
    m_Localized: "\u5982\u679C\u4F60\u51C6\u5907\u62FF\u53BB\u62FC\u70B9\uFF0C\u5C31\u4F18\u5148\u60F3
      [\u62FC\u70B9\u65F6]\uFF1B\u5982\u679C\u4F60\u51C6\u5907\u5355\u65B9\u9762\u653B\u51FB\uFF0C\u5C31\u4F18\u5148\u60F3
      [\u5355\u65B9\u9762\u653B\u51FB\u65F6]\uFF1B\u5982\u679C\u5C40\u52BF\u4E0D\u7A33\u5B9A\uFF0C[\u4F7F\u7528\u65F6]
      \u5F80\u5F80\u6700\u7A33\u5B9A\uFF0C\u6700\u666E\u9002\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688044
    m_Localized: "\u5148\u5207\u4E00\u6B21\u6280\u80FD\uFF0C\u518D\u51B3\u5B9A\u8FD9\u56DE\u5408\u51C6\u5907\u600E\u4E48\u6253\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688045
    m_Localized: "\u5F00\u59CB\u56DE\u5408\u5E76\u5BF9\u7167\u7ED3\u679C"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688046
    m_Localized: "\u5F00\u6218\u540E\u8BF7\u5BF9\u7167\u5B9E\u9645\u53D1\u751F\u7684\u7ED3\u7B97\u53BB\u7406\u89E3\u8BCD\u6761\uFF1A\u54EA\u6761\u7EBF\u8FDB\u4E86\u62FC\u70B9\uFF0C\u54EA\u6761\u7EBF\u53D8\u6210\u4E86\u5355\u65B9\u9762\u653B\u51FB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688047
    m_Localized: "\u5148\u770B\u6E05\u6280\u80FD\u8BCD\u6761\u5E76\u5207\u597D\u6280\u80FD\uFF0C\u518D\u5F00\u59CB\u56DE\u5408\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688048
    m_Localized: "\u5148\u628A\u654C\u65B9\u4E24\u6761\u884C\u52A8\u5B8C\u6574\u770B\u5B8C"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688049
    m_Localized: "\u8FD9\u4E00\u6218\u628A\u539F\u6765\u7684\u7B2C\u4E94\u6218\u548C\u7B2C\u516D\u6218\u5408\u6210\u4E00\u573A\u3002\u4F60\u8981\u540C\u65F6\u5224\u65AD\u4E09\u4EF6\u4E8B\uFF1A\u54EA\u6761\u7EBF\u66F4\u5FEB\uFF0C\u54EA\u6761\u7EBF\u66F4\u5371\u9669\uFF0C\u4F60\u624B\u91CC\u7684\u6280\u80FD\u66F4\u9002\u5408\u62FF\u53BB\u62FC\u70B9\u8FD8\u662F\u62FF\u53BB\u6253\u7A7A\u7EBF\u3002\n\n\u5148\u770B\u6E05\u654C\u65B9\u4E24\u6761\u884C\u52A8\uFF0C\u518D\u5F00\u59CB\u89C4\u5212\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688050
    m_Localized: "\u5148\u67E5\u770B\u654C\u65B9\u6280\u80FD\u8BF4\u660E\uFF0C\u518D\u51B3\u5B9A\u8FD9\u4E00\u56DE\u5408\u600E\u4E48\u63A5\u7EBF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688051
    m_Localized: "\u5148\u5207\u5230\u9002\u5408\u5F53\u524D\u8BA1\u5212\u7684\u6280\u80FD"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688052
    m_Localized: "\u8BF7\u5148\u5207\u6362\u4E00\u6B21\u6280\u80FD\uFF0C\u518D\u5F00\u59CB\u56DE\u5408\u3002\n\n\u5982\u679C\u4F60\u51C6\u5907\u6B63\u9762\u62E6\u622A\u9AD8\u4F18\u5148\u7EA7\u76EE\u6807\uFF0C\u5C31\u4F18\u5148\u8003\u8651\u5199\u7740
      [\u62FC\u70B9\u65F6] \u7684\u6280\u80FD\uFF1B\u5982\u679C\u4F60\u51C6\u5907\u628A\u4E00\u62DB\u7559\u7ED9\u7A7A\u7EBF\uFF0C\u5C31\u4F18\u5148\u8003\u8651\u5199\u7740
      [\u5355\u65B9\u9762\u653B\u51FB\u65F6] \u7684\u6280\u80FD\uFF1B\u5982\u679C\u5C40\u52BF\u8FD8\u4E0D\u7A33\u5B9A\uFF0C\u5199\u7740
      [\u4F7F\u7528\u65F6] \u7684\u6280\u80FD\u901A\u5E38\u66F4\u7A33\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688053
    m_Localized: "\u5148\u5207\u5230\u9002\u5408\u5F53\u524D\u76EE\u6807\u7684\u6280\u80FD\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688054
    m_Localized: "\u5F00\u59CB\u56DE\u5408\u5E76\u6838\u5BF9\u4F60\u7684\u5224\u65AD\u662F\u5426\u6B63\u786E"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688055
    m_Localized: "\u5F00\u6218\u540E\u8BF7\u5BF9\u7167\u5B9E\u9645\u7ED3\u7B97\u53BB\u590D\u76D8\uFF1A\u4F60\u4F18\u5148\u5904\u7406\u7684\u90A3\u6761\u7EBF\u662F\u4E0D\u662F\u56E0\u4E3A\u66F4\u5FEB\u6216\u66F4\u5371\u9669\uFF1F\u4F60\u5207\u8FC7\u53BB\u7684\u6280\u80FD\u662F\u4E0D\u662F\u5403\u5230\u4E86\u81EA\u5DF1\u771F\u6B63\u9700\u8981\u7684\u90A3\u4E00\u6BB5\u5A01\u529B\u4FEE\u6B63\uFF1F\n\n\u8FD9\u4E00\u6218\u7684\u76EE\u6807\u4E0D\u662F\u5355\u7EAF\u6253\u8D62\uFF0C\u800C\u662F\u628A\u201C\u901F\u5EA6\u3001\u80FD\u91CF\u3001\u8BCD\u6761\u65F6\u673A\u201D\u653E\u8FDB\u540C\u4E00\u5957\u5224\u65AD\u91CC\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688056
    m_Localized: "\u5148\u5B8C\u6210\u8BFB\u62DB\u548C\u5207\u6280\u80FD\uFF0C\u518D\u5F00\u59CB\u56DE\u5408\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688057
    m_Localized: "\u6309\u5B8C\u6574\u987A\u5E8F\u505A\u4E00\u6B21\u56DE\u5408\u89C4\u5212"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688058
    m_Localized: "\u8FD9\u4E00\u6218\u628A\u524D\u9762\u7684\u77E5\u8BC6\u5408\u5728\u4E00\u8D77\u3002\u5F00\u59CB\u524D\u8BF7\u6309\u8FD9\u4E2A\u987A\u5E8F\u5224\u65AD\uFF1A\n1.
      \u5148\u770B\u54EA\u6761\u654C\u65B9\u884C\u52A8\u66F4\u5FEB\u3001\u66F4\u5148\u7ED3\u7B97\u3002\n2.
      \u518D\u770B\u54EA\u6761\u7EBF\u66F4\u5371\u9669\u3002\n3. \u7136\u540E\u5224\u65AD\u81EA\u5DF1\u624B\u91CC\u7684\u6280\u80FD\u66F4\u9002\u5408\u62FC\u70B9\u8FD8\u662F\u6253\u7A7A\u7EBF\u3002\n4.
      \u6700\u540E\u786E\u8BA4\u80FD\u91CF\u591F\u4E0D\u591F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688059
    m_Localized: "\u5148\u67E5\u770B\u654C\u65B9\u6280\u80FD\u8BF4\u660E\uFF0C\u5B8C\u6210\u8FD9\u4E00\u8F6E\u89C4\u5212\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688060
    m_Localized: "\u5207\u6280\u80FD\u540E\u518D\u5F00\u59CB\u56DE\u5408"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688061
    m_Localized: "\u8BF7\u5148\u5207\u6280\u80FD\uFF0C\u518D\u5F00\u59CB\u56DE\u5408\u3002\u4F60\u73B0\u5728\u7EC3\u7684\u662F\u5B8C\u6574\u6D41\u7A0B\uFF1A\u901F\u5EA6\u51B3\u5B9A\u4F18\u5148\u7EA7\uFF0C\u8BCD\u6761\u51B3\u5B9A\u7528\u9014\uFF0C\u80FD\u91CF\u51B3\u5B9A\u4F60\u80FD\u4E0D\u80FD\u771F\u7684\u628A\u8FD9\u62DB\u63A5\u51FA\u53BB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688062
    m_Localized: "\u5148\u5207\u4E00\u6B21\u6280\u80FD\uFF0C\u518D\u8FDB\u5165\u7ED3\u7B97\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688063
    m_Localized: "\u5F00\u59CB\u56DE\u5408\u5E76\u68C0\u67E5\u4F60\u7684\u89C4\u5212\u662F\u5426\u6210\u7ACB"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688064
    m_Localized: "\u8FDB\u5165\u7ED3\u7B97\u540E\uFF0C\u770B\u6E05\u695A\u4F60\u539F\u672C\u4EE5\u4E3A\u4F1A\u53D1\u751F\u7684\u4E8B\u6709\u6CA1\u6709\u771F\u7684\u53D1\u751F\uFF1A\u8BE5\u62FC\u70B9\u7684\u6709\u6CA1\u6709\u62FC\u5230\uFF0C\u8BE5\u6253\u7A7A\u7EBF\u7684\u6709\u6CA1\u6709\u6210\u529F\u6253\u51FA\u53BB\uFF0C\u80FD\u91CF\u6709\u6CA1\u6709\u88AB\u5B89\u6392\u5BF9\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688065
    m_Localized: "\u5148\u5B8C\u6210\u8FD9\u4E00\u8F6E\u89C4\u5212\uFF0C\u518D\u5F00\u59CB\u56DE\u5408\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688066
    m_Localized: "\u5148\u81EA\u5DF1\u505A\u4E00\u6B21\u5B8C\u6574\u5224\u65AD"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688067
    m_Localized: "\u8FD9\u662F\u6700\u7EC8\u6F14\u7EC3\u3002\u5F00\u59CB\u524D\u8BF7\u81EA\u5DF1\u5B8C\u6210\u4E00\u6B21\u5B8C\u6574\u5224\u65AD\uFF1A\n1.
      \u5148\u8BFB\u654C\u65B9\u901F\u5EA6\u548C\u884C\u52A8\u3002\n2. \u5224\u65AD\u54EA\u6761\u7EBF\u5FC5\u987B\u63A5\uFF0C\u54EA\u6761\u7EBF\u53EF\u4EE5\u653E\u3002\n3.
      \u7ED9\u6BCF\u4E00\u62DB\u627E\u6700\u5408\u9002\u7684\u7528\u9014\u3002\n4.
      \u786E\u8BA4\u80FD\u91CF\u591F\u4E0D\u591F\u3002\n\n\u8FD9\u4E00\u6218\u91CC\u4F1A\u987A\u5E26\u51FA\u73B0\u72B6\u6001\u56FE\u6807\uFF0C\u4F46\u4E0D\u518D\u5355\u72EC\u62C6\u6210\u4E00\u6574\u8BFE\uFF1B\u4F60\u53EA\u9700\u8981\u50CF\u6B63\u5F0F\u6218\u6597\u90A3\u6837\u8BFB\u61C2\u6280\u80FD\u8BF4\u660E\u548C\u56FE\u6807\u5373\u53EF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688068
    m_Localized: "\u5148\u67E5\u770B\u654C\u65B9\u6280\u80FD\u8BF4\u660E\uFF0C\u518D\u5F00\u59CB\u6700\u7EC8\u6F14\u7EC3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688069
    m_Localized: "\u5F00\u59CB\u6700\u7EC8\u6F14\u7EC3"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688070
    m_Localized: "\u8FD9\u4E00\u6218\u4E0D\u518D\u9010\u6B65\u8981\u6C42\u4F60\u5B8C\u6210\u6BCF\u4E2A\u5C0F\u52A8\u4F5C\uFF0C\u628A\u524D\u516D\u6218\u5B66\u5230\u7684\u5185\u5BB9\u4E00\u8D77\u7528\u51FA\u6765\u5373\u53EF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688071
    m_Localized: "\u5148\u5B8C\u6210\u5224\u65AD\uFF0C\u518D\u5F00\u59CB\u6700\u7EC8\u6F14\u7EC3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688072
    m_Localized: "目标转移"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688073
    m_Localized: "速度更高的一方，可以更主动地改变目标关系，让危险攻击打到更适合承受的人身上。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688074
    m_Localized: "\u606D\u559C\u4F60\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688075
    m_Localized: "你已经理解了速度在目标转移中的作用。"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688076
    m_Localized: "\u606D\u559C\u4F60\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688077
    m_Localized: "\u4F60\u5B66\u4F1A\u4E86\u67E5\u770B\u53CB\u65B9\u7684\u6280\u80FD\u548C\u80FD\u91CF\uFF0C\u9009\u62E9\u66F4\u5408\u9002\u7684\u6280\u80FD\u7B56\u7565\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688078
    m_Localized: "\u62FC\u70B9\u65F6\u7684\u5A01\u529B\u4FEE\u6B63\u53EA\u4F5C\u7528\u4E8E\u62FC\u70B9"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688079
    m_Localized: "[\u62FC\u70B9\u65F6] \u53EA\u4F1A\u5728\u771F\u6B63\u8FDB\u5165\u62FC\u70B9\u65F6\u751F\u6548\u3002\u5982\u679C\u540C\u4E00\u62DB\u6700\u540E\u62FC\u70B9\u80DC\u5229\u6253\u51FA\u4F24\u5BB3\uFF0C\u8FD9\u6761\u5A01\u529B\u4FEE\u6B63\u4E0D\u4F1A\u751F\u6548\u3002\u4F46\u662F\u4F60\u53EF\u4EE5\u4E00\u76F4\u5728\u62FC\u70B9\u6216\u8FFD\u51FB\u65F6\u83B7\u5F97[\u4F7F\u7528\u65F6]\u7684\u52A0\u6210\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688080
    m_Localized: "\u5355\u65B9\u9762\u653B\u51FB\u65F6\u5403\u5230\u7684\u662F\u53E6\u4E00\u5957\u52A0\u6210"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688081
    m_Localized: "\u5F53\u4F60\u7684\u884C\u52A8\u6CA1\u6709\u88AB\u62E6\u4F4F\u65F6\uFF0C\u5199\u7740
      [\u5355\u65B9\u9762\u653B\u51FB\u65F6] \u7684\u90A3\u90E8\u5206\u4F1A\u751F\u6548\u3002\u540C\u6837\u7684\uFF0C\u5355\u65B9\u9762\u653B\u51FB\u65F6\u4E5F\u53EF\u4EE5\u7A33\u5B9A\u83B7\u5F97[\u4F7F\u7528\u65F6]\u7684\u52A0\u6210\u3002\u4F7F\u7528\u5E26\u6709\u9519\u8BEF\u8BCD\u6761\u7684\u6280\u80FD\uFF0C\u6536\u76CA\u4F1A\u660E\u663E\u53D8\u5DEE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688082
    m_Localized: "\u606D\u559C\u4F60\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688083
    m_Localized: "\u73B0\u5728\u4F60\u5DF2\u7ECF\u638C\u63E1\u4E09\u79CD\u6280\u80FD\u8BCD\u6761\u5206\u522B\u5728\u54EA\u4E2A\u7ED3\u7B97\u91CC\u751F\u6548\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 22781576688084
    m_Localized: "\u7B2C\u4E94\u6218\u7ED3\u675F"
