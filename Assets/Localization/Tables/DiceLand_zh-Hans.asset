    m_Localized: "\u9009\u62E9\u4E00\u4E2A\u9057\u7269\uFF0C\u8F6C\u6362\u4E3A\u83B7\u5F97\u4E00\u4E2A\u540C\u54C1\u8D28\u9057\u7269"
