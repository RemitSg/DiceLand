  - optionId: 2
    optionLabel: "\u201C\u6211\u8D85\uFF01\u201D"
    requiredMoney: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u4F60\u81EA\u4FE1\u5FC3\u6EE1\u6EE1\uFF0C\u548C\u524D\u9762\u90A3\u4E9B\u8001\u5934\u6253\u8FC7\u7684\u4EA4\u9053\u8BA9\u4F60\u4E00\u4E0B\u5B50\u5C31\u77E5\u9053\u8BE5\u600E\u4E48\u8BF4\u4E86\uFF1A\u201C\u8FD9\u662F\u2026\u2026\u201D\r\n\r\n\u4E0D\u5BF9\uFF01\u54EA\u91CC\u4E0D\u5BF9\uFF01\u4F60\u770B\u5230\u90A3\u8001\u5934\u5DF2\u7ECF\u5FEB\u618B\u4E0D\u4F4F\u7B11\u4E86\u3002\r\n\r\n\u201C\u6211\u8D85\uFF0C\u8FD9\u662F\u4E8C\uFF01\u201D\u4F60\u53CD\u5E94\u8FC7\u6765\uFF0C\u4E00\u4E0B\u5B50\u8BF4\u51FA\u4E86\u8001\u5934\u60F3\u542C\u7684\u6B63\u786E\u7B54\u6848\u3002\r\n\r\n\u201C\u5509\uFF0C\u53EF\u60DC\u53EF\u60DC\uFF0C\u8001\u5934\u5B50\u8FD9\u811A\u5FEB\u8981\u751F\u9508\u4E86\uFF0C\u8FD8\u662F\u6CA1\u80FD\u7B49\u5230\u6D3B\u52A8\u4E00\u4E0B\u554A\u3002\u6765\uFF0C\u62FF\u597D\u4F60\u7684\u5956\u52B1\u3002\u201D\u8001\u5934\u628A\u4E00\u4E2A\u5E03\u888B\u5B50\u9012\u7ED9\u4E86\u4F60\u3002\u4F60\u63A5\u8FC7\u6765\uFF0C\u6B23\u559C\u82E5\u72C2\uFF0C\u603B\u7B97\u53EF\u4EE5\u8212\u8212\u670D\u670D\u5730\u8FDB\u4F11\u606F\u5BA4\u4E86\u3002\r\n\r\n\u201C\u6B38\uFF01\u6765\uFF0C\u9A97\uFF0C\u6765\uFF0C\u5077\u88AD\uFF01\u201D\u8001\u5934\u7684\u58F0\u97F3\u7A81\u7136\u60F3\u8D77\uFF0C\u4F60\u5C41\u80A1\u4E00\u9635\u5267\u75DB\uFF0C\u50CF\u706B\u7BAD\u4E00\u6837\u98DE\u8FDB\u4E86\u4F11\u606F\u5BA4\uFF0C\u8EAB\u540E\u8FD8\u54CD\u8D77\u8001\u5934\u6700\u540E\u7684\u8BDD\u8BED\uFF0C\u90A3\u662F\u4E00\u53E3\u76F8\u58F0\u8154\uFF1A\r\n\r\n\u201C\u9017\u4F60\u73A9\u513F\uFF01\u201D"
