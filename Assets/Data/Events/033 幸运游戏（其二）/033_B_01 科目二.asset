  m_EditorClassIdentifier: 
  eventId: 033_B_01
  eventName: "\u79D1\u76EE\u4E8C"
  eventContent: "\u4F60\u6765\u5230\u4E86\u201C\u79D1\u76EE\u4E8C\u201D\uFF0C\u4E0D\u7BA1\u4F60\u600E\u4E48\u8FDB\u6765\u7684\uFF0C\u4F60\u8FD8\u662F\u6765\u4E86\u3002\u4F60\u53D1\u73B0\u659C\u5761\u4E0A\u505C\u7740\u4E00\u8F86\u8F66\uFF0C\u526F\u9A7E\u9A76\u4E0A\u5750\u7740\u76D1\u8003\u5B98\u3002\u201C\u79D1\u76EE\u4E8C\u8003\u8BD5\u624B\u52A8\u6321\uFF0C\u5761\u9053\u9876\u5B9A\u70B9\u548C\u8D77\u6B65\u9879\u76EE\uFF01\u7184\u706B\u6263\u4E00\u767E\u5206\uFF01\u538B\u7EBF\u6263\u4E00\u767E\u5206\uFF01\u8D77\u6B65\u6E9C\u8F66\u8DDD\u79BB\u8FC7\u957F\u6263\u4E00\u767E\u5206\uFF01\u505C\u6B62\u540E\u2026\u2026\u201D\r\n\r\n\u4F60\u80F8\u6709\u6210\u7AF9\u5730\u5750\u5728\u4E86\u9A7E\u9A76\u4F4D\uFF0C\u591A\u5E74\u7684\u9A7E\u8F66\u7ECF\u9A8C\u8BA9\u4F60\u6839\u672C\u4E0D\u60E7\u4EFB\u4F55\u6311\u6218\u3002\u4F60\u6B63\u6253\u7B97\u6302\u6321\uFF0C\u4E00\u626D\u5934\uFF0C\u4F60\u5C45\u7136\u53D1\u73B0\u8FD9\u8F66\u662F\u81EA\u52A8\u6321\uFF01\r\n\r\n\u4F60\u51B3\u5B9A\uFF1A"
  eventIllustration: {fileID: 0}
  options:
  - optionId: 1
    optionLabel: "\u201C\u8FD9\u8F66\u662F\u81EA\u52A8\u6321\uFF0C\u54EA\u6765\u7684\u5761\u8D77\uFF1F\u201D"
    requiredMoney: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u8003\u5B98\u6012\u6C14\u51B2\u51B2\u5730\u4E0B\u8F66\uFF0C\u628A\u4F60\u4ECE\u9A7E\u9A76\u5EA7\u4E0A\u62FD\u4E86\u4E0B\u6765\uFF0C\u4E00\u811A\u8E39\u56DE\u4E86\u76E5\u6D17\u5BA4\uFF0C\u4F60\u597D\u4E0D\u5BB9\u6613\u62FC\u597D\u7684\u5C41\u80A1\u53C8\u6454\u6210\u4E86\u516B\u74E3\uFF0C\u5FD9\u7740\u62FC\u5C41\u80A1\u7684\u4F60\u9690\u9690\u7EA6\u7EA6\u542C\u5230\u4E86\u8003\u5B98\u7684\u58F0\u97F3\uFF1A\u201C\u6211\u4E0D\u77E5\u9053\u8FD9\u662F\u81EA\u52A8\u6321\u554A\uFF1F\u8FD8\u8981\u4F60\u6559\uFF1F\u6211\u662F\u8003\u5B98\u8FD8\u662F\u4F60\u662F\u8003\u5B98\uFF1F\u201D\r"
