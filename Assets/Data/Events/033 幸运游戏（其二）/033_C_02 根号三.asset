  - optionId: 3
    optionLabel: "\u201C\u770B\u89C1\u674E\u534E\u8FD9\u53AE\u5C31\u6CA1\u597D\u4E8B\uFF01\u6211\u5DF2\u7ECF\u5E2E\u4ED6\u5199\u4E86\u591F\u591A\u7684\u4F5C\u6587\u4E86\uFF01\u8BA9\u4ED6\u81EA\u5DF1\u5199\uFF01\u201D"
    requiredMoney: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u8001\u5934\u672C\u6765\u5C31\u9ED1\u7684\u8138\u66F4\u9ED1\u4E86\uFF1A\u201C\u4FFA\u8001\u5934\u5B50\u4E03\u5341\u591A\u5E74\u6BCF\u5929\u90FD\u5E2E\u674E\u534E\u5199\u4F5C\u6587\uFF0C\u4F60\u7B97\u4EC0\u4E48\uFF01\u8FD8\u597D\u610F\u601D\u5ACC\u591A\uFF1F\u54E6\u4F60\u8FD9\u611A\u8822\u7684\u4E1C\u6D77\u571F\u62E8\u9F20\uFF0C\u6211\u73B0\u5728\u5C31\u66FF\u4E0A\u5E1D\u72E0\u72E0\u5730\u8E22\u4F60\u7684\u5C41\u80A1\uFF01\u201D\r\n\r\n\u4ED6\u62FD\u7740\u4F60\u7684\u8863\u9886\u771F\u7684\u5F00\u59CB\u72E0\u72E0\u5730\u8E22\u4F60\u7684\u5C41\u80A1\uFF0C\u4F60\u75BC\u5F97\u76F4\u53EB\uFF0C\u4F46\u8001\u5934\u8FD8\u662F\u4E0D\u6B7B\u5FC3\uFF1A\u201C\u628A\u4F5C\u6587\u5199\u4E86\uFF0C\u6211\u8BA9\u4F60\u8D70\uFF01\u201D\r\n\r\n\u65E0\u5948\u4E4B\u4E0B\uFF0C\u4F60\u53EA\u597D\u8BA4\u8BA4\u771F\u771F\u5730\u5199\u5B8C\u4E86\u4F5C\u6587\uFF0C\u8001\u5934\u63A5\u8FC7\u6765\u4E00\u770B\uFF0C\u53D1\u73B0\u4F60\u5199\u4E86499\u4E2A\u6839\u53F7\u4E8C\uFF0C\u5C31\u7ED3\u5C3E\u5199\u4E861\u4E2A\u6839\u53F7\u4E09\u3002\r\n\r\n\u201C\u597D\u5427\u597D\u5427\uFF01\u7ED9\u6211\u6EDA\uFF01\u201D\u8001\u5934\u7528\u5C3D\u5168\u529B\u8E39\u4E86\u4E00\u811A\uFF0C\u4F60\u88AB\u8E39\u8FDB\u4E86\u201C\u6839\u53F7\u56DB\uFF1F\u201D"
