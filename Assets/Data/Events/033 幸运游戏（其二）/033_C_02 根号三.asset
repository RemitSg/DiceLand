  m_Script: {fileID: 11500000, guid: 37bbc450bd9189847a6a4d61c848e46e, type: 3}
  m_Name: "033_C_02 \u6839\u53F7\u4E09"
  m_EditorClassIdentifier: 
  eventId: 033_C_02
  eventName: "\u6839\u53F7\u4E09"
  eventContent: "\u4F60\u8FDB\u5165\u201C\u6839\u53F7\u4E09\u201D\uFF0C\u4E0D\u7BA1\u4F60\u600E\u4E48\u8FDB\u6765\u7684\uFF0C\u597D\u6B79\u4F60\u73B0\u5728\u5C31\u5728\u8FD9\u91CC\u3002\u4F60\u53D1\u73B0\u623F\u95F4\u6B63\u4E2D\u592E\u5B64\u96F6\u96F6\u5730\u6446\u7740\u4E00\u672C\u4E66\uFF0C\u4E66\u7684\u5C01\u76AE\u4E0A\u9664\u4E86\u4E00\u4E2A\u5927\u5927\u7684\u6839\u53F7\u4E09\u4EC0\u4E48\u4E5F\u6CA1\u5199\u3002\r\n\r\n\u4F60\u73AF\u987E\u56DB\u5468\uFF0C\u53D1\u73B0\u8FD9\u623F\u95F4\u7A7A\u7A7A\u8361\u8361\u3002\u6CA1\u7B49\u4F60\u7F13\u53E3\u6C14\uFF0C\u4E00\u4E2A\u9ED1\u8138\u8001\u5934\u7A81\u7136\u5728\u4F60\u80CC\u540E\u5927\u53EB\u4E00\u58F0\uFF0C\u5DEE\u70B9\u6CA1\u628A\u4F60\u5413\u6B7B\u3002\r\n\r\n\u201C\u5E74\u8F7B\u4EBA\uFF0C\u5E2E\u5E2E\u8001\u5934\u5B50\uFF0C\u8001\u5934\u5B50\u6587\u5316\u4E0D\u9AD8\uFF0C\u8FD9\u4F5C\u6587\u4E0D\u4F1A\u5199\u3002\u201D\u8001\u5934\u9012\u7ED9\u4F60\u4E00\u5F20\u7A3F\u7EB8\uFF0C\u4F60\u77A5\u4E86\u4E00\u773C\uFF0C\u9898\u76EE\u5C31\u8BA9\u4F60\u7EF7\u4E0D\u4F4F\uFF1A\u201C\u9AD8\u4E09\u4E00\u73ED\u7684\u674E\u534E\u7684\u5916\u56FD\u7B14\u53CB\u4E3A\u674E\u534E\u51FA\u4E86\u4E00\u9053\u9898\u2014\u2014\u8BF7\u4EE5\u2018\u5B64\u72EC\u7684\u6839\u53F7\u4E09\u2019\u4E3A\u9898\uFF0C\u7528\u82F1\u8BED\u5199\u4E00\u7BC7\u4F5C\u6587\uFF0C\u4E0D\u5C11\u4E8E500\u5B57\uFF0C\u674E\u534E\u6CA1\u6709\u5934\u7EEA\uFF0C\u8BF7\u4F60\u5E2E\u674E\u534E\u5B8C\u6210\u4F5C\u6587\uFF0C\u8BA9\u4ED6\u80FD\u7ED9\u5916\u56FD\u7B14\u53CB\u56DE\u4FE1\u3002\u201D\r\n\r\n\u4F60\u51B3\u5B9A\uFF1A"
  eventIllustration: {fileID: 0}
  options:
  - optionId: 1
    optionLabel: "\u201C\u4EC0\u4E48\u7834\u73A9\u610F\uFF0C\u6211\u627E\u832C\u90FD\u4E0D\u4F1A\u8FD9\u4E48\u627E\uFF01\u201D"
    requiredMoney: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u8001\u5934\u9A82\u9A82\u54A7\u54A7\u5730\u62A1\u8D77\u62F3\u5934\uFF0C\u4E00\u62F3\u628A\u4F60\u6253\u5012\u5728\u5730\u3002\u201C\u90A3\u4FFA\u600E\u4E48\u4EA4\u5DEE\uFF01\u4F60\u8003\u8651\u8FC7\u4FFA\u8001\u5934\u5B50\u7684\u611F\u53D7\u5417\uFF1F\u201D\u4F60\u8FDE\u8FDE\u6C42\u9976\uFF0C\u8001\u5934\u6839\u672C\u4E0D\u542C\uFF0C\u53EA\u662F\u72E0\u72E0\u8E39\u5728\u4F60\u5C41\u80A1\u4E0A\uFF0C\u4F60\u76F4\u76F4\u98DE\u51FA\uFF0C\u4E00\u5934\u683D\u5230\u4E86\u201C\u79D1\u76EE\u56DB\u201D\u8003\u573A\uFF0C\u968F\u540E\u88AB\u76D1\u8003\u5458\u6254\u4E86\u51FA\u53BB\u3002\r\n\r\n\u201C\u8BA9\u8001\u5934\u79BB\u6211\u8FDC\u70B9\u5427\uFF01\u201D\u4F60\u4EF0\u5929\u5927\u54ED\u3002"
