  - optionId: 2
    optionLabel: "\u201C\u5199\u2026\u2026\u5199\u5927\u4E2A\u7684\uFF01\u201D"
    requiredMoney: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u4F60\u98A4\u6296\u7740\u624B\u63A5\u8FC7\u7A3F\u7EB8\u548C\u7B14\uFF0C\u54AC\u7740\u9F3B\u5C16\u6101\u7709\u82E6\u8138\uFF0C\u542D\u54E7\u542D\u54E7\u4E24\u4E2A\u5C0F\u65F6\u7EC8\u4E8E\u628A\u4F5C\u6587\u5199\u51FA\u6765\u4E86\u3002\u8001\u5934\u63A5\u8FC7\u6765\u4E00\u770B\uFF0C\u53D1\u73B0\u4F60\u5199\u4E86499\u4E2A\u6839\u53F7\u4E8C\uFF0C\u5C31\u4E2D\u95F4\u5199\u4E861\u4E2A\u6839\u53F7\u4E09\u3002\r\n\r\n\u201C\u6709\u6C34\u5E73\uFF0C\u6709\u5185\u6DB5\uFF01\u201D\u8001\u5934\u5411\u4F60\u7AD6\u8D77\u5927\u62C7\u6307\u201C\u90A3\u4F60\u77E5\u9053\u4FFA\u8BE5\u600E\u4E48\u4EA4\u5DEE\u5417\uFF1F\u201D\r\n\r\n\u89C1\u4F60\u6123\u5728\u539F\u5730\uFF0C\u8001\u5934\u677F\u8D77\u8138\uFF0C\u5927\u6B65\u4E0A\u524D\uFF0C\u62FD\u4F4F\u4F60\u7684\u8863\u9886\uFF1A\u201C\u5C31\u77E5\u9053\u7ED9\u8001\u5934\u5B50\u6316\u5751\uFF01\u4F60\u8FD9\u7F3A\u5FB7\u73A9\u610F\u513F\u8FD8\u662F\u56DE\u53BB\u626B\u5395\u6240\u5427\uFF01\u201D\r\n\r\n\u4E0D\u51FA\u610F\u5916\uFF0C\u4F60\u53C8\u56DE\u5230\u4E86\u76E5\u6D17\u5BA4\u3002\u4F60\u5DF2\u7ECF\u9EBB\u6728\u4E86\uFF0C\u53EA\u662F\u832B\u7136\u5730\u62FC\u7740\u788E\u6210\u516B\u74E3\u7684\u5C41\u80A1\u3002"
