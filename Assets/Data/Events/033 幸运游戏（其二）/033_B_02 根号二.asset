  - optionId: 3
    optionLabel: "\u201C\u56DE\u54E5\u8C2D\u5427\uFF0C\u8759\u8760\u4FA0\u8BF4\u4ED6\u4E0D\u6253\u4F60\u4E86\u3002\u201D"
    requiredMoney: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u201C\u4EC0\u4E48\u4E71\u4E03\u516B\u7CDF\u7684\uFF01\u770B\u4E0D\u61C2\u5C31\u8BF4\u770B\u4E0D\u61C2\uFF01\u53FD\u91CC\u5495\u565C\u7684\u8BF4\u4EC0\u4E48\u5462\uFF01\u201D\u8001\u5934\u9A82\u9A82\u54A7\u54A7\u5730\u6293\u7740\u4F60\u7684\u8863\u9886\u628A\u4F60\u6254\u8FDB\u4E86\u201C\u79D1\u76EE\u4E09\u201D\uFF0C\u4F60\u4E00\u5C41\u80A1\u5750\u5728\u4E86\u8003\u573A\u4E0A\uFF0C\u5468\u56F4\u4E00\u7FA4\u8003\u751F\u9707\u60CA\u5730\u770B\u7740\u4F60\u3002\u626D\u5934\u770B\u770B\u5C41\u80A1\u4E0A\u7684\u978B\u5370\uFF0C\u4F60\u6B32\u54ED\u65E0\u6CEA\uFF1A\u201C\u6211\u771F\u6C42\u6C42\u4E86\uFF0C\u522B\u8BA9\u6211\u518D\u78B0\u89C1\u8001\u5934\u4E86\uFF01\u201D"
