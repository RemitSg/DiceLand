  m_EditorClassIdentifier: 
  eventId: 033_E_01
  eventName: "\u4F11\u606F\u5BA4"
  eventContent: "\u4F60\u8FDB\u5165\u4E86\u4F11\u606F\u5BA4\uFF0C\u4E0D\u7BA1\u4F60\u662F\u600E\u4E48\u6765\u7684\uFF0C\u662F\u98DE\u8FDB\u6765\u7684\u8FD8\u662F\u8D70\u8FDB\u6765\u7684\uFF0C\u4F60\u4E5F\u6210\u529F\u5730\u8FDB\u5165\u4E86\u4F11\u606F\u5BA4\uFF0C\u8FD9\u662F\u4F55\u7B49\u58EE\u4E3E\uFF01\u4F60\u8BE5\u4E3A\u81EA\u5DF1\u6B22\u547C\uFF01\r\n\r\n\u6B22\u547C\uFF01\r\n\r\n\u4F60\u4E00\u62AC\u5934\uFF0C\u5C31\u770B\u89C1\u9A97\u4F60\u7684\u5973\u5DEB\u7B11\u5475\u5475\u5730\u7AD9\u5728\u4F60\u9762\u524D\u3002\r\n\r\n\u201C\u4F60\u8FD8\u662F\u51ED\u7740\u81EA\u5DF1\u7684\u672C\u4E8B\u6765\u4E86\uFF0C\u4E0D\u9519\u4E0D\u9519\uFF0C\u8BA9\u6211\u770B\u770B\u4F60\u8FD9\u4E00\u8DEF\u662F\u600E\u4E48\u8D70\u6765\u7684\u3002\u201D\r\n\r\n\u5973\u5DEB\u5411\u4F60\u4F38\u51FA\u624B\uFF0C\u793A\u610F\u4F60\u9012\u51FA\u4EC0\u4E48\u4E1C\u897F\uFF0C\u4F60\u51B3\u5B9A\uFF1A\r"
  eventIllustration: {fileID: 0}
  options:
  - optionId: 1
    optionLabel: "\u201C\u6211\u2026\u2026\u6211\u2026\u2026\u6211\u2026\u2026\u201D"
    requiredMoney: 0
    requiredMoneyPercent: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u4F60\u72B9\u8C6B\u4E86\u4E00\u4E0B\uFF0C\u628A\u4F60\u80FD\u60F3\u5230\u7684\u4E1C\u897F\u9012\u7ED9\u4E86\u5973\u5DEB\uFF0C\u5973\u5DEB\u4E00\u770B\uFF0C\u6447\u4E86\u6447\u5934\uFF1A\u201C\u4F60\u6CA1\u62FF\u5230\u554A\uFF0C\u90A3\u4F60\u56DE\u53BB\u518D\u62FF\u5427\u3002\u201D\r\n\r\n\u5979\u98DE\u8D77\u4E00\u811A\u628A\u4F60\u8E39\u56DE\u4E86\u76E5\u6D17\u5BA4\uFF0C\u8FD9\u6B21\u7531\u4E8E\u98DE\u5F97\u592A\u8FDC\uFF0C\u4F60\u7684\u5C41\u80A1\u6454\u6210\u4E86\u516D\u5341\u56DB\u74E3\u3002\r\n\r\n\u4F60\u6B32\u54ED\u65E0\u6CEA\uFF1A\u201C\u8FD9\u8BA9\u6211\u600E\u4E48\u62FC\u554A\uFF01\u201D"
