  m_Name: "033_C_01 \u79D1\u76EE\u4E09"
  m_EditorClassIdentifier: 
  eventId: 033_C_01
  eventName: "\u79D1\u76EE\u4E09"
  eventContent: "\u4F60\u6765\u5230\u4E86\u201C\u79D1\u76EE\u4E09\u201D\uFF0C\u4E0D\u7BA1\u4F60\u600E\u4E48\u8FDB\u6765\u7684\uFF0C\u4F46\u4F60\u7EC8\u4E8E\u8FDB\u6765\u4E86\u3002\u8DDD\u79BB\u62FF\u5230\u9A7E\u7167\u518D\u8FDB\u4E86\u4E00\u6B65\uFF0C\u4F60\u5174\u594B\u5730\u6413\u6413\u624B\uFF0C\u53D1\u73B0\u8003\u573A\u91CC\u6709\u4E00\u8F86\u8F66\uFF0C\u526F\u9A7E\u9A76\u4E0A\u5750\u7740\u76D1\u8003\u5B98\u3002\u201C\u79D1\u76EE\u4E09\u8003\u8BD5\uFF0C\u76F4\u7EBF\u884C\u9A76\u3001\u53D8\u9053\u3001\u8D85\u8F66\u3001\u6389\u5934\u3001\u4F1A\u8F66\u3001\u901A\u8FC7\u8DEF\u53E3\u3001\u591C\u95F4\u884C\u9A76\u3001\u96E8\u96EA\u5929\u6C14\u884C\u9A76\u3001\u7D27\u6025\u60C5\u51B5\u5904\u7406\uFF01\u201D\r\n\r\n\u76D1\u8003\u5B98\u6447\u4E0B\u8F66\u7A97\uFF0C\u5411\u4F60\u4F38\u51FA\u624B\uFF0C\u6413\u4E86\u6413\u624B\u6307\uFF0C\u4F60\u4E00\u4E0B\u5C31\u660E\u767D\u4E86\u3002\r\n\r\n\u4F60\u51B3\u5B9A\uFF1A"
  eventIllustration: {fileID: 0}
  options:
  - optionId: 1
    optionLabel: "\u201C\u51C6\u5907\u597D\u4E86\uFF01\u201D"
    requiredMoney: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u4F60\u628A\u8EAB\u4EFD\u8BC1\u9012\u7ED9\u4E86\u76D1\u8003\u5B98\uFF0C\u76D1\u8003\u5B98\u9762\u65E0\u8868\u60C5\u5730\u6536\u4E0B\uFF0C\u793A\u610F\u4F60\u7ED5\u8F66\u4E00\u5468\uFF0C\u51ED\u501F\u957F\u671F\u4EE5\u6765\u79EF\u7D2F\u7684\u7ECF\u9A8C\uFF0C\u4F60\u975E\u5E38\u987A\u5229\u5730\u901A\u8FC7\u4E86\u8003\u8BD5\uFF0C\u76D1\u8003\u5B98\u5FAE\u7B11\u7740\u628A\u8EAB\u4EFD\u8BC1\u8FD8\u7ED9\u4F60\uFF0C\u793A\u610F\u4F60\u53EF\u4EE5\u53BB\u8003\u79D1\u76EE\u56DB\u4E86\u3002\r\n\r\n\u770B\u7740\u8FDC\u53BB\u7684\u5C0F\u7834\u8F66\uFF0C\u4F60\u7684\u5FC3\u60C5\u683C\u5916\u7684\u597D\u3002"
