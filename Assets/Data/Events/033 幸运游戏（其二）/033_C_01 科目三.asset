  - optionId: 3
    optionLabel: "\u201C\u8FD9\u5565\u610F\u601D\uFF1F\u4E0D\u8003\u4E86\uFF01\u201D"
    requiredMoney: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u4F60\u706B\u5192\u4E09\u4E08\uFF0C\u521A\u9A82\u5B8C\uFF0C\u4F60\u53D1\u73B0\u76D1\u8003\u5B98\u4E00\u8138\u61F5\u903C\uFF0C\u4F60\u4E5F\u4E00\u8138\u61F5\u903C\uFF0C\u751A\u81F3\u773C\u524D\u7684\u5C0F\u7834\u8F66\u4E5F\u4E00\u8138\u61F5\u903C\u3002\u201C\u53E8\u53E8\u5565\u5462\uFF1F\u6709\u75C5\u5427\uFF01\u6211\u8BA9\u4F60\u628A\u8EAB\u4EFD\u8BC1\u7ED9\u6211\uFF01\u201D\u53CD\u5E94\u8FC7\u6765\u7684\u76D1\u8003\u5B98\u5FCD\u4E0D\u4F4F\u7834\u53E3\u5927\u9A82\u201C\u4EE5\u540E\u8003\u9A7E\u7167\u524D\u7684\u4F53\u68C0\u5F97\u591A\u6D4B\u6D4B\u667A\u529B\uFF01\u56DE\u53BB\u4E0A\u5B66\u5427\u5B69\u5B50\uFF01\u201D\u4ED6\u62A1\u5706\u4E86\u817F\u8E39\u51FA\u4E00\u811A\uFF0C\u4F60\u88AB\u8E39\u8FDB\u4E86\u201C\u6839\u53F7\u56DB\uFF1F\u201D\r\n\r\n\u8FD9\u4E00\u811A\u592A\u75BC\u4E86\uFF01\u4F60\u53D1\u73B0\u5C31\u7B97\u4F60\u51C6\u5907\u4E86\u57AB\u5B50\uFF0C\u5C41\u80A1\u8FD8\u662F\u88AB\u8E39\u6210\u4E86\u516B\u74E3\uFF0C\u4F60\u8FD8\u5F97\u62FC\uFF0C\u771F\u662F\u592A\u5012\u9709\u4E86\uFF01"
