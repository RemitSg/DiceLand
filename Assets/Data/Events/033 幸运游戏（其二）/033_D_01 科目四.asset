  m_Name: "033_D_01 \u79D1\u76EE\u56DB"
  m_EditorClassIdentifier: 
  eventId: 033_D_01
  eventName: "\u79D1\u76EE\u56DB"
  eventContent: "\u4F60\u6765\u5230\u4E86\u201C\u79D1\u76EE\u56DB\u201D\uFF0C\u4E0D\u7BA1\u4F60\u600E\u4E48\u8FDB\u6765\u7684\uFF0C\u4F46\u4F60\u603B\u7B97\u8FDB\u6765\u4E86\u3002\u8DDD\u79BB\u62FF\u5230\u9A7E\u7167\u53EA\u6709\u4E00\u6B65\u4E4B\u9065\uFF0C\u4F60\u5174\u51B2\u51B2\u5730\u62FF\u8D77\u4E86\u684C\u5B50\u4E0A\u7684\u4E66\uFF0C\u4E66\u540D\u53EB\u300A\u79D1\u76EE\u56DB\u8003\u8BD5\u5927\u7EB2\u300B\u3002\r\n\r\n\u4F60\u51B3\u5B9A\uFF1A"
  eventIllustration: {fileID: 0}
  options:
  - optionId: 1
    optionLabel: "\u201C\u6211\u6709\u79D1\u76EE\u4E00\u57FA\u7840\uFF0C\u770B\u4E2A\u9B3C\u554A\uFF01\u201D"
    requiredMoney: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u4F60\u628A\u4E66\u6254\u5230\u4E00\u8FB9\uFF0C\u81EA\u4FE1\u6EE1\u6EE1\u5730\u5F00\u59CB\u7B54\u9898\uFF0C\u4F60\u505A\u5B8C\u4E8649\u9053\u9898\uFF0C\u7B54\u5BF9\u4E8644\u9053\u9898\uFF0C\u5C31\u5DEE\u4E00\u70B9\u5C31\u80FD\u901A\u8FC7\u8003\u8BD5\uFF0C\u5F53\u4F60\u8BA4\u771F\u9605\u8BFB\u6700\u540E\u4E00\u9053\u9898\u65F6\uFF0C\u4F60\u53D1\u73B0\u9898\u76EE\u7ADF\u7136\u662F\u9053\u586B\u7A7A\u9898\u2014\u2014\u201C\u4E3B\u8003\u5B98\u59D3\u4EC0\u4E48\uFF1F\u201D\u4F60\u6C14\u5F97\u6380\u4E86\u684C\u5B50\u3002\u201C\u8FD9\u9B3C\u77E5\u9053\uFF01\u201D\r\n\r\n\u201C\u7B49\u51B7\u9759\u671F\u8FC7\u4E86\u518D\u56DE\u6765\u8003\u5427\uFF0C\u843D\u699C\u751F\uFF01\u201D\u4E3B\u8003\u5B98\u5E7D\u5E7D\u5730\u56DE\u7B54\u9053\u3002\r\n\r\n\u4ED6\u4E0D\u7B49\u4F60\u4E89\u8FA9\uFF0C\u98DE\u8D77\u4E00\u811A\u628A\u4F60\u8E39\u56DE\u4E86\u5395\u6240\u3002\u4E00\u60F3\u8D77\u81EA\u5DF1\u4ED8\u51FA\u4E86\u90A3\u4E48\u591A\u52AA\u529B\uFF0C\u6700\u7EC8\u8FD8\u662F\u53EA\u80FD\u4E0E\u9A6C\u6876\u4E3A\u4F34\uFF0C\u4F60\u62B1\u7740\u9A6C\u6876\u75DB\u54ED\u6D41\u6D95\u3002\r\n\r\n\u4E0B\u6B21\u4F60\u6253\u7B97\u53BB\u5B66\u7F8E\u672F\uFF0C\u4F60\u7B03\u5B9A\u8003\u5B98\u4E0D\u6562\u8BA9\u4F60\u843D\u699C\u3002"
