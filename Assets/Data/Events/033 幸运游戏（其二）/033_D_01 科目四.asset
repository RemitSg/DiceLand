    resultContent: "\u4F60\u8BA4\u771F\u9605\u8BFB\u4E86\u300A\u79D1\u76EE\u56DB\u8003\u8BD5\u5927\u7EB2\u300B\uFF0C\u5927\u7EB2\u6700\u540E\u7684\u201C\u4E3B\u8003\u5B98\u59D3\u674E\u201D\u8BA9\u4F60\u7591\u60D1\uFF0C\u4F60\u8D70\u4E0A\u8003\u573A\uFF0C\u53D1\u73B0\u6700\u540E\u4E00\u9053\u9898\u76EE\u662F\u201C\u4E3B\u8003\u5B98\u59D3\u4EC0\u4E48\uFF1F\u201D\uFF0C\u4F60\u6BEB\u4E0D\u72B9\u8C6B\u5730\u586B\u4E0A\u4E86\u201C\u674E\u201D\u5B57\uFF0C\u4EA4\u5377\uFF0C\u901A\u8FC7\u4E86\u8003\u8BD5\uFF0C\u4F60\u5174\u9AD8\u91C7\u70C8\u5730\u79BB\u5F00\u4E86\u8003\u573A\uFF0C\u4F60\u7EC8\u4E8E\u53EF\u4EE5\u5408\u6CD5\u5F00\u8F66\u4E86\uFF01\r"
