  m_Name: "014 \u4F4E\u8BED\u4E95"
  m_EditorClassIdentifier: 
  eventId: 014
  eventName: "\u4F4E\u8BED\u4E95"
  eventContent: "\u4F60\u4EEC\u62B5\u8FBE\u4E00\u5EA7\u5373\u5C06\u88AB\u6C34\u5E93\u6DF9\u6CA1\u7684\u5C71\u6751\u3002\u6751\u6C11\u6B63\u5728\u642C\u8D70\u6700\u540E\u51E0\u53EA\u6728\u7BB1\uFF0C\u7960\u5802\u524D\u5374\u8FD8\u6709\u4E00\u540D\u5E74\u8F7B\u5973\u4EBA\u6CA1\u6709\u79BB\u5F00\u3002\n\n\u6751\u957F\u8BF4\uFF0C\u90A3\u4F4D\u53EB\u6797\u6800\uFF0C\u662F\u6797\u69D0\u7684\u5973\u513F\u3002\u5979\u4ECA\u665A\u8981\u53BB\u4F4E\u8BED\u4E95\uFF0C\u60F3\u5728\u5C01\u4E95\u524D\u786E\u8BA4\u7236\u4EB2\u9057\u7269\u91CC\u53CD\u590D\u63D0\u5230\u7684\u4F20\u8BF4\u3002\n\n\u6700\u8FD1\u4E95\u8FB9\u5E38\u6709\u6B8B\u54CD\u6E38\u8361\u3002\u6751\u957F\u5E0C\u671B\u4F60\u4EEC\u966A\u5979\u8D70\u4E00\u8D9F\u3002"
  eventIllustration: {fileID: 0}
  options:
  - optionId: 1
    optionLabel: "\u7B54\u5E94\u540C\u884C"
    requiredMoney: 0
    consequenceDescription: "\u8FDB\u5165\u7279\u6B8A\u526F\u672C\uFF1A\u4F4E\u8BED\u4E95"
    resultContent: "\u6797\u6800\u63D0\u7740\u4E00\u53EA\u5C01\u58F0\u6728\u5323\u8D70\u6765\u3002\n\n\u201C\u9EBB\u70E6\u4F60\u4EEC\u4E86\u3002\u6211\u662F\u56DE\u58F0\u4FEE\u590D\u5E08\uFF0C\u53EA\u60F3\u6536\u4E00\u6BB5\u4E95\u58F0\uFF0C\u786E\u8BA4\u4F20\u8BF4\u662F\u771F\u662F\u5047\u3002\u8DEF\u4E0A\u5982\u679C\u6709\u4E1C\u897F\u9760\u8FD1\uFF0C\u8BF7\u5E2E\u6211\u4E89\u53D6\u4E00\u70B9\u65F6\u95F4\u3002\u201D\n\n\u5979\u6253\u5F00\u6728\u5323\uFF0C\u91CC\u9762\u653E\u7740\u4E00\u679A\u7070\u767D\u8272\u7684\u56DE\u58F0\u87BA\u3001\u4E09\u6839\u8C03\u97F3\u9488\u3001\u4E00\u5757\u5C01\u58F0\u8721\u548C\u51E0\u5F20\u523B\u7740\u7EC6\u5C0F\u97F3\u7EB9\u7684\u7A7A\u767D\u8D1D\u7247\u3002"
