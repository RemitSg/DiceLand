  m_Script: {fileID: 11500000, guid: 37bbc450bd9189847a6a4d61c848e46e, type: 3}
  m_Name: "031_C_01 \u76D6\u68FA\u5B9A\u8BBA"
  m_EditorClassIdentifier: 
  eventId: 031_C_01
  eventName: "\u76D6\u68FA\u5B9A\u8BBA"
  eventContent: "\u4F60\u548C\u738B\u50A8\u7684\u4EB2\u4FE1\u6740\u51FA\u5CE1\u8C37\uFF0C\u62A4\u9001\u53D7\u4F24\u7684\u738B\u50A8\u56DE\u5230\u5BAB\u524D\u3002\n\n\u4E8C\u738B\u5B50\u65E9\u5DF2\u7387\u519B\u7B49\u5728\u90A3\u91CC\u3002\n\n\u201C\u4F60\u56DE\u6765\u4E86\uFF0C\u5F11\u7236\u7684\u755C\u751F\u3002\u201D\u4E8C\u738B\u5B50\u51B7\u51B7\u770B\u7740\u738B\u50A8\uFF0C\u201C\u7236\u4EB2\u771F\u662F\u770B\u8D70\u4E86\u773C\uFF0C\u7ADF\u7ACB\u4F60\u8FD9\u79CD\u53DB\u5F92\u4E3A\u738B\u50A8\u3002\u4ECA\u5929\uFF0C\u6211\u4F1A\u66FF\u4ED6\u6E05\u7406\u95E8\u6237\u3002\u201D\n\n\u738B\u50A8\u88AB\u903C\u5230\u77F3\u95E8\u524D\uFF0C\u624B\u4E2D\u65AD\u5251\u4E0D\u4F4F\u53D1\u6296\uFF1A\u201C\u6211\u4E0D\u662F\u53DB\u5F92\u3002\u4E0D\u8981\u542C\u4FE1\u5C0F\u4EBA\u7684\u8C17\u8A00\u3002\u201D\n\n\u201C\u6240\u6709\u4EBA\u90FD\u770B\u89C1\u4E86\uFF0C\u4F60\u8FD8\u60F3\u62B5\u8D56\uFF1F\u201D\u4E8C\u738B\u5B50\u633A\u5251\u4E0A\u524D\uFF0C\u5C06\u738B\u50A8\u9489\u5728\u77F3\u95E8\u4E0A\u3002\u9C9C\u8840\u98DE\u6E85\uFF0C\u738B\u50A8\u6B7B\u6B7B\u76EF\u7740\u4ED6\uFF1A\u201C\u4F60\u4F1A\u540E\u6094\u2026\u2026\u201D\n\n\u8BDD\u97F3\u672A\u843D\uFF0C\u4E8C\u738B\u5B50\u62D4\u5251\uFF0C\u780D\u4E0B\u4E86\u738B\u50A8\u7684\u5934\u9885\u3002\n\n\u8001\u8005\u53C8\u7AD9\u5230\u4F60\u8EAB\u8FB9\uFF1A\u201C\u8FD9\u5C31\u662F\u6211\u5BB6\u8001\u7237\u7684\u9057\u61BE\u3002\u56DE\u7B54\u6211\uFF0C\u4ED6\u662F\u5426\u80CC\u53DB\u4E86\u56FD\u5BB6\uFF1F\u201D"
  eventIllustration: {fileID: 0}
  options:
  - optionId: 1
    optionLabel: "\u4ED6\u80CC\u53DB\u4E86\u56FD\u5BB6\uFF0C\u4ED6\u8BE5\u6B7B\uFF01"
    requiredMoney: 0
    requiredMoneyPercent: 0
    consequenceDescription: "\u8FDB\u5165\u4E00\u573A\u7EDD\u671B\u7684\u6218\u6597\uFF0C\u7ED3\u675F\u4E8B\u4EF6"
    resultContent: "\u4F60\u7684\u56DE\u7B54\u6BEB\u4E0D\u72B9\u8C6B\u3002\u8001\u8005\u6C89\u9ED8\u534A\u664C\uFF0C\u5FFD\u7136\u4EF0\u5929\u5927\u7B11\u3002\n\n\u201C\u6211\u4EE5\u4E3A\u4F60\u80FD\u770B\u51FA\u771F\u76F8\uFF0C\u6CA1\u60F3\u5230\u4F60\u4E5F\u6709\u773C\u65E0\u73E0\u3002\u5929\u610F\u554A\uFF0C\u5929\u610F\uFF01\u201D\n\n\u4ED6\u6447\u8EAB\u4E00\u53D8\uFF0C\u7ADF\u6210\u4E86\u5168\u8EAB\u67D3\u8840\u7684\u738B\u50A8\uFF0C\u8EAB\u62AB\u95EA\u70C1\u8840\u5149\u7684\u6218\u7532\uFF0C\u4E3E\u8D77\u67D3\u8840\u957F\u5251\u5411\u4F60\u65A9\u6765\u3002"
