  m_Script: {fileID: 11500000, guid: 37bbc450bd9189847a6a4d61c848e46e, type: 3}
  m_Name: "031 王储的遗产"
  m_EditorClassIdentifier: 
  eventId: 031
  eventName: "王储的遗产"
  eventContent: "你经过一座破败不堪的城堡。厚重的木门被暴力洞穿，门前土地上插着一块腐朽木牌，字迹大多已经被风雨磨掉，只剩一句还能辨认：\n\n“得到我的一切……”\n\n城堡深处传来似有似无的吸引，像有人隔着长久的岁月等待回应。"
  eventIllustration: {fileID: 0}
  options:
  - optionId: 1
    optionLabel: "感觉有缘，进去看看"
    requiredMoney: 0
    consequenceDescription: "失去 5 行动点，进入特殊副本：王储的复仇"
    resultContent: "你跨过破损的大门，城堡内阴冷潮湿。大厅里只有一张倾斜的木桌，桌上压着半张腐朽字条。\n\n字条上写着：“你是否愿意继承他的一切？”"
    builtInEffectType: 17
    effectAmount: 0
