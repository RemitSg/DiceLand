  eventContent: "\u4F60\u4EEC\u8D76\u8DEF\u7684\u65F6\u5019\uFF0C\u4E00\u4E2A\u7A1A\u5AE9\u7684\u58F0\u97F3\u5728\u4E0D\u77E5\u4F55\u5904\u54CD\u8D77\uFF0C\u4F60\u627E\u4E86\u534A\u5929\uFF0C\u53D1\u73B0\u7ADF\u7136\u662F\u4E00\u4E2A\u5F69\u8272\u7684\u8611\u83C7\u5728\u8BF4\u8BDD\u3002\u4F60\u8E72\u4E0B\u8EAB\u4ED4\u7EC6\u542C\uFF0C\u201C\u4F60\u597D\u5440\uFF01\u4F60\u597D\u5440\uFF01\u6211\u662F\u4E00\u4E2A\u9B54\u6CD5\u8611\u83C7\uFF01\u6211\u53EF\u4EE5\u5B9E\u73B0\u4F60\u7684\u613F\u671B\uFF01\u201D\n\u4F60\u51B3\u5B9A\u2026\u2026"
