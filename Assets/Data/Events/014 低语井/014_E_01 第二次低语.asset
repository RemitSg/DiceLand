  eventContent: "\u6797\u6800\u6CA1\u6709\u7ACB\u523B\u79BB\u5F00\u3002\u5979\u8BF7\u4F60\u4EEC\u518D\u966A\u5979\u542C\u4E00\u6B21\u3002\n\n\u201C\u5982\u679C\u6211\u6BCD\u4EB2\u771F\u7684\u7559\u4E0B\u8FC7\u8BDD\uFF0C\u6211\u81F3\u5C11\u8981\u77E5\u9053\u5979\u4E3A\u4EC0\u4E48\u5931\u8E2A\u3002\u201D\n\n\u5979\u9760\u8FD1\u4E95\u6CBF\u3002\u4F60\u4EEC\u6276\u4F4F\u6536\u58F0\u9635\uFF0C\u9632\u6B62\u8C03\u97F3\u9488\u88AB\u98CE\u5439\u5012\u3002"
