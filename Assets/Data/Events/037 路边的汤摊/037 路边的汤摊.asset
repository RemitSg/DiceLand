    specialDungeonDestinationEntryIndex: -1
  - optionId: GatherFirewood
    optionLabel: "\u53BB\u6797\u5B50\u91CC\u6361\u67F4"
    requiredMoney: 0
    requiredMoneyPercent: 0
    consequenceDescription: "\u6D88\u8017 1 \u884C\u52A8\u70B9\uFF0C\u5168\u961F\u5404\u6062\u590D 15% \u6700\u5927\u751F\u547D\u503C\u3002"
    resultContent: "\u4F60\u8D39\u4E86\u4E00\u70B9\u529F\u592B\u62B1\u56DE\u4E00\u6346\u67AF\u679D\u3002\u644A\u4E3B\u5341\u5206\u611F\u8C22\u4F60\u7684\u5E2E\u52A9\uFF0C\u7ED9\u4F60\u4EEC\u4E00\u4EBA\u76DB\u4E86\u4E00\u7897\u9999\u6C14\u56DB\u6EA2\u7684\u8089\u6C64\u3002"
