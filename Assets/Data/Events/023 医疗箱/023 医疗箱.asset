    requiredMoney: 30
    consequenceDescription: "\u961F\u4F0D\u6CBB\u7597\u76F8\u5F53\u4E8E\u6700\u5927\u751F\u547D\u503C
      50% \u7684\u8840\u91CF"
    resultContent: "\u4F60\u4ED8\u94B1\u4E4B\u540E\uFF0C\u90A3\u4E9B\u7EF7\u5E26\u548C\u533B\u7597\u5668\u5177\u7ADF\u7136\u81EA\u5DF1\u98D8\u4E86\u8D77\u6765\u5F00\u59CB\u7ED9\u4F60\u4EEC\u5305\u624E\u6CBB\u7597\u3002\n\u4E0D\u51FA\u4E00\u4F1A\u513F\uFF0C\u4F60\u4EEC\u7684\u4F24\u52BF\u5C31\u5DF2\u7ECF\u8FD1\u4E4E\u65E0\u788D\u3002"
