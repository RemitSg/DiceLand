  eventId: 023
  eventName: "\u533B\u7597\u7BB1"
  eventContent: "\u4E00\u53EA\u767D\u8272\u533B\u7BB1\u653E\u5728\u77F3\u5934\u4E0A\uFF0C\u7BB1\u76D6\u5FAE\u5FAE\u5F39\u5F00\uFF0C\u91CC\u9762\u7684\u7EF7\u5E26\u6574\u9F50\u5F97\u4E0D\u50CF\u88AB\u4EBA\u7528\u8FC7\u3002\n\u201C30
    \u91D1\u5E01\u4E00\u6B21\uFF0C\u6982\u4E0D\u8D4A\u8D26\u3002\u201D\u65C1\u8FB9\u7684\u724C\u5B50\u4E0A\u5199\u9053\u3002\n\u4F46\u6CA1\u6709\u8FD9\u91CC\u6CA1\u6709\u4EFB\u4F55\u770B\u8D77\u6765\u50CF\u533B\u751F\u7684\u4EBA\uFF0C\u6216\u8005\u8BF4\uFF0C\u8FD9\u91CC\u6839\u672C\u5C31\u6CA1\u6709\u4EBA\u3002"
