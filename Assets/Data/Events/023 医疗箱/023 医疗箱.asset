    consequenceDescription: "\u961F\u4F0D\u751F\u547D -30%\uFF0C\u83B7\u5F97 50 \u91D1\u5E01"
    resultContent: "\u4F60\u51B3\u5B9A\u62FF\u8D70\u522B\u4EBA\u7ED3\u8D26\u7528\u7684\u94B1\uFF0C\u53CD\u6B63\u8FD9\u91CC\u4E5F\u6CA1\u6709\u4EBA\u770B\u7BA1\u3002\n\u5F53\u4F60\u628A\u77F3\u5934\u4E0A\u7684\u91D1\u5E01\u88C5\u8FDB\u53E3\u888B\u7684\u65F6\u5019\uFF0C\u533B\u7597\u7BB1\u91CC\u7F13\u7F13\u98D8\u51FA\u4E86\u4E00\u628A\u624B\u672F\u5200\uFF0C\u968F\u540E\u72E0\u72E0\u5730\u624E\u5728\u4E86\u4F60\u7684\u5C41\u80A1\u4E0A\u3002\n\u201C\u55F7\uFF01\uFF01\uFF01\uFF01\uFF01\u201D\n\u4F60\u843D\u8352\u800C\u9003\uFF0C\u597D\u5728\u662F\u94B1\u62FF\u5230\u4E86\u3002"
