  eventId: 022
  eventName: "\u7F20\u7EBF\u6728\u5076"
  eventContent: "\u4E00\u4E2A\u7834\u65E7\u6728\u5076\u6302\u5728\u6811\u679D\u4E0A\uFF0C\u7EF3\u5B50\u52D2\u4F4F\u4E86\u5B83\u7684\u8116\u5B50\uFF0C\u770B\u4E0A\u53BB\u50CF\u662F\u88AB\u540A\u6B7B\u4E86\u3002\u6728\u5076\u8EAB\u4E0A\u7684\u7EBF\u4E00\u76F4\u5EF6\u4F38\u5230\u6797\u5B50\u6DF1\u5904\u3002\u5B83\u7684\u5934\u4F4E\u5782\u7740\uFF0C\u50CF\u662F\u5728\u7B49\u4EBA\u5E2E\u5B83\u89E3\u5F00\u3002"
  eventIllustration: {fileID: 0}
  options:
  - optionId: 1
    optionLabel: "\u5E2E\u5B83\u89E3\u5F00"
    requiredMoney: 0
    consequenceDescription: "\u83B7\u5F97 1 \u4E2A\u968F\u673A\u7F55\u89C1\u6218\u5229\u54C1"
    resultContent: "\u4F60\u722C\u4E0A\u4E86\u6811\uFF0C\u8270\u96BE\u5730\u89E3\u5F00\u4E86\u6728\u5076\u8116\u5B50\u4E0A\u7684\u7EF3\u7D22\u3002\n\u5C31\u5728\u4F60\u89E3\u5F00\u7EF3\u7D22\u7684\u4E00\u77AC\u95F4\uFF0C\u6728\u5076\u50CF\u662F\u88AB\u8D4B\u4E88\u4E86\u751F\u547D\u4E00\u822C\u6323\u8131\u4E86\u4F60\u7684\u624B\uFF0C\u968F\u540E\u81EA\u5DF1\u8DF3\u5230\u5730\u4E0A\u6454\u4E86\u4E2A\u7C89\u788E\u3002\n\u6216\u8BB8\u6709\u7684\u65F6\u5019\u8FC7\u5EA6\u7684\u81EA\u7531\u662F\u81EA\u53D6\u706D\u4EA1\u3002\n\u4F60\u53F9\u4E86\u53E3\u6C14\uFF0C\u62FE\u8D70\u4E86\u6728\u5076\u5C38\u4F53\u91CC\u4E00\u4E2A\u95EA\u95EA\u53D1\u5149\u7684\u7269\u4EF6\u3002"
