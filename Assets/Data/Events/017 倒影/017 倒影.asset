  m_Script: {fileID: 11500000, guid: 37bbc450bd9189847a6a4d61c848e46e, type: 3}
  m_Name: "017 \u5012\u5F71"
  m_EditorClassIdentifier: 
  eventId: 017
  eventName: "\u5012\u5F71"
  eventContent: "\u8DEF\u9762\u4E0A\u6709\u4E00\u7247\u6D45\u6D45\u7684\u6C34\u6D3C\uFF0C\u4F46\u5929\u6C14\u5982\u6B64\u9177\u70ED\u4E0D\u5E94\u6709\u79EF\u6C34\uFF0C\u597D\u5947\u5FC3\u9A71\u4F7F\u4F60\u8D70\u8FD1\u770B\u770B\u3002\n\u8FD9\u5B8C\u5168\u5C31\u662F\u4E00\u6EE9\u666E\u901A\u7684\u79EF\u6C34\uFF0C\u6B63\u5F53\u4F60\u8981\u8D70\u65F6\uFF0C\u4F60\u7A81\u7136\u610F\u8BC6\u5230\u4E00\u4E2A\u5F88\u8BE1\u5F02\u7684\u4E8B\u60C5\u2014\u2014\u5012\u5F71\u4E2D\u7684\u4F60\u6CA1\u6709\u4EFB\u4F55\u52A8\u4F5C\u3002\n\u53EA\u662F\u2026\u2026\u6B7B\u6B7B\u76EF\u7740\u6C34\u6D3C\u5916\u7684\u4F60\u3002"
  eventIllustration: {fileID: 0}
  options:
  - optionId: 1
    optionLabel: "\u8E29\u788E\u5012\u5F71"
    requiredMoney: 0
    consequenceDescription: "\u906D\u9047\u4E00\u573A\u7279\u6B8A\u7684\u6218\u6597"
    resultContent: "\u4F60\u4E00\u811A\u8E29\u788E\u4E86\u5012\u5F71\uFF0C\u5927\u7247\u7684\u6D9F\u6F2A\u8BA9\u4F60\u4E00\u65F6\u770B\u4E0D\u6E05\u6C34\u9762\u91CC\u9762\uFF0C\u6E85\u8D77\u7684\u6C34\u82B1\u6563\u843D\u7684\u5230\u5904\u90FD\u662F\u3002\n\u76F4\u5230\u6D9F\u6F2A\u9759\u9759\u5E73\u606F\uFF0C\u4F60\u624D\u770B\u6E05\u91CC\u9762\u3002\n\u65E9\u5DF2\u7A7A\u65E0\u4E00\u4EBA\u3002\n\u4F60\u62AC\u5934\uFF0C\u53D1\u73B0\u91CC\u9762\u7684\u5012\u5F71\u4E0D\u77E5\u4EC0\u4E48\u65F6\u5019\u5DF2\u7ECF\u7AD9\u5728\u4E86\u4F60\u8EAB\u524D\u3002"
