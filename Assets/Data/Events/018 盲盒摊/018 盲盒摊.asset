  eventContent: "\u4E00\u4E2A\u6CA1\u6709\u62DB\u724C\u7684\u5C0F\u644A\u6446\u5728\u8DEF\u65C1\uFF0C\u644A\u4E3B\u628A\u6240\u6709\u8D27\u7269\u90FD\u88C5\u5728\u4E86\u51E0\u4E2A\u76D2\u5B50\u91CC\u9762\uFF0C\u4F3C\u4E4E\u53EB\u76F2\u76D2\u3002\n\u201C\u8D70\u8FC7\u8DEF\u8FC7\uFF0C\u5BA2\u4EBA\u8981\u4E0D\u8981\u4E70\u4E2A\u76F2\u76D2\uFF1F\u7269\u8D85\u6240\u503C\uFF01\u4E70\u540E\u4E0D\u9000\u4E0D\u6362\uFF01\u201D"
