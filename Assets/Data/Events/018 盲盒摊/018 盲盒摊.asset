  - optionId: 3
    optionLabel: "\u9009\u6700\u5927\u7684\u5305\u88F9"
    requiredMoney: 10
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u201C\u5FEB\u5FEB\u5FEB\u770B\u770B\u91CC\u9762\u6709\u4EC0\u4E48~\uFF1F\u201D\n\u4F60\u6253\u5F00\u4E86\u5305\u88F9\uFF0C\u53D1\u73B0\u91CC\u9762\u8FD8\u6709\u4E00\u4E2A\u5305\u88F9\u3002\n\u4F60\u83B7\u5F97\u4E86\u4E00\u4E2A\u5305\u88F9\uFF0C\u6216\u8BB8\u662F\u53EB\u5305\u88F9\u4E2D\u7684\u5305\u88F9\u3002\n\u5305\u5305\u88F9\uFF1F\n\u5305\u5305\u88F9\u88F9\uFF1F\n\u5305\u88F9\u5305\u88F9\u7684\u5305\u88F9\uFF1F\n\u6B63\u5F53\u4F60\u601D\u7D22\u7684\u65F6\u5019\uFF0C\u5546\u4EBA\u5DF2\u7ECF\u8DD1\u8DEF\u4E86\u3002"
