  - optionId: 1
    optionLabel: "\u5FEB\u901F\u901A\u8FC7"
    requiredMoney: 0
    consequenceDescription: "\u961F\u4F0D\u751F\u547D -10%\uFF0C\u8FD4\u8FD8 2 \u884C\u52A8\u70B9"
    resultContent: "\u4F60\u4EEC\u5C0F\u5FC3\u7FFC\u7FFC\u5730\u4E0A\u4E86\u6865\uFF0C\u6865\u677F\u4E0D\u6EE1\u7684\u560E\u5431\u58F0\u56DE\u8361\u5728\u5CE1\u8C37\u4E2D\u3002\u5C31\u5728\u4F60\u4EEC\u5373\u5C06\u5230\u8FBE\u5BF9\u5CB8\u7684\u65F6\u5019\uFF0C\u811A\u4E0B\u7684\u6728\u677F\u7A81\u7136\u5F00\u88C2\uFF0C\u5343\u94A7\u4E00\u53D1\u4E4B\u9645\uFF0C\u4F60\u6293\u4F4F\u4E86\u6865\u677F\u4E24\u4FA7\u7684\u7EF3\u7D22\u3002\u6700\u7EC8\u4F60\u4EEC\u8FD8\u662F\u6709\u60CA\u65E0\u9669\u5730\u5230\u8FBE\u4E86\u5BF9\u5CB8\uFF0C\u867D\u7136\u624B\u4E0A\u88AB\u7C97\u7CD9\u7684\u7EF3\u5B50\u5272\u51FA\u4E86\u8BB8\u591A\u4F24\u53E3\u3002"
