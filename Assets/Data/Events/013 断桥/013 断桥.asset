  eventContent: "\u4E00\u5EA7\u65E7\u540A\u6865\u6A2A\u5728\u5CE1\u8C37\u4E0A\u65B9\uFF0C\u6865\u677F\u5DF2\u7ECF\u7F3A\u4E86\u4E09\u5206\u4E4B\u4E00\u3002\u98CE\u4ECE\u7F1D\u9699\u91CC\u94BB\u8FC7\uFF0C\u6728\u677F\u53D1\u51FA\u5431\u5440\u5431\u5440\u7684\u58F0\u97F3\uFF0C\u770B\u4E0A\u53BB\u5C8C\u5C8C\u53EF\u5371\u3002"
