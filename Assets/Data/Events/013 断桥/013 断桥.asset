  - optionId: 3
    optionLabel: "\u4FEE\u8865\u65AD\u6865"
    requiredMoney: 0
    consequenceDescription: "\u5931\u53BB 2 \u884C\u52A8\u70B9\uFF0C\u83B7\u5F97
      25 ~ 35 \u91D1\u5E01"
    resultContent: "\u4F60\u4EEC\u51B3\u5B9A\u5C06\u8FD9\u5EA7\u6447\u6447\u6B32\u5760\u65AD\u6865\u4FEE\u8865\u4E00\u756A\u3002\n\u4E00\u756A\u529F\u592B\u540E\uFF0C\u4E00\u5EA7\u7ED3\u5B9E\u7684\u65B0\u6865\u4F2B\u7ACB\u5728\u4E86\u5CE1\u8C37\u4E2D\u592E\uFF0C\u4F60\u6EE1\u610F\u5730\u70B9\u4E86\u70B9\u5934\u3002\n\u6B64\u65F6\u8DEF\u8FC7\u4E86\u53E6\u4E00\u884C\u4EBA\uFF0C\u4ED6\u4EEC\u60CA\u5947\u5730\u770B\u7740\u8FD9\u5EA7\u65B0\u6865\u4E0E\u4F60\u6500\u8C08\uFF0C\u4ED6\u4EEC\u662F\u7ECF\u5E38\u8D70\u8FD9\u6761\u8DEF\u7684\u5546\u961F\uFF0C\u788D\u4E8E\u8D35\u91CD\u7684\u8D27\u7269\uFF0C\u4ED6\u4EEC\u65E0\u6CD5\u63A5\u53D7\u4EFB\u4F55\u8D70\u4E0A\u8FD9\u5EA7\u6865\u540E\u7684\u8D27\u7269\u635F\u5931\uFF0C\u6240\u4EE5\u6BCF\u6B21\u90FD\u8981\u7ED5\u5F88\u8FDC\u7684\u8DEF\u3002\u4ECA\u5929\u770B\u5230\u6709\u4EBA\u628A\u8FD9\u5EA7\u6865\u4FEE\u597D\u4E86\u5F88\u662F\u611F\u6FC0\uFF0C\u4E8E\u662F\u786C\u585E\u7ED9\u4F60\u4E86\u4E00\u4E9B\u94B1\u8D22\u8D27\u7269\uFF0C\u5E76\u4E14\u795D\u4F60\u4EEC\u65C5\u9014\u987A\u5229\u3002"
