  eventName: "\u65E0\u4E3B\u7684\u4FE1\u4EF6"
  eventContent: "\u4E00\u5C01\u5C01\u8721\u5B8C\u597D\u7684\u8840\u7EA2\u7684\u4FE1\u63D2\u5728\u8DEF\u724C\u7F1D\u9699\u91CC\u3002\u4FE1\u5C01\u4E0A\u6CA1\u6709\u7F72\u540D\uFF0C\u53EA\u5199\u7740\uFF1A\u201C\u8BF7\u4E0D\u8981\u6253\u5F00\u3002\u201D"
