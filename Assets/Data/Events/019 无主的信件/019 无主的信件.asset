    optionLabel: "\u6253\u5F00\u4FE1\u4EF6"
    requiredMoney: 0
    consequenceDescription: "\uFF1F\uFF1F\uFF1F"
    resultContent: "\u4F60\u6253\u5F00\u4E86\u4FE1\u4EF6\uFF0C\u4FE1\u4EF6\u91CC\u9762\u753B\u7740\u4E00\u4E9B\u6B6A\u4E03\u626D\u516B\u7684\u672A\u77E5\u7B26\u53F7\uFF0C\u8FD9\u4E9B\u7B26\u53F7\u770B\u8D77\u6765\u4ECD\u5728\u4E0D\u65AD\u5730\u8815\u52A8\uFF0C\u4EFF\u4F5B\u6709\u751F\u547D\u4E00\u822C\u3002\n\u6E10\u6E10\u5730\uFF0C\u5B83\u4EEC\u53D8\u5F97\u7329\u7EA2\u800C\u523A\u773C\uFF0C\u4E00\u80A1\u5F3A\u70C8\u7684\u4E0D\u9002\u611F\u6D8C\u4E0A\u4F60\u7684\u5FC3\u5934\uFF0C\u4F60\u4E00\u4E2A\u6CA1\u6293\u7A33\uFF0C\u4FE1\u4ECE\u4F60\u6307\u5C16\u6ED1\u843D\u5230\u5730\u4E0A\u3002\n\u5C31\u5728\u4F60\u7684\u624B\u6307\u79BB\u5F00\u7EB8\u5F20\u7684\u90A3\u4E00\u523B\uFF0C\u4F60\u7684\u4E0D\u9002\u611F\u6D88\u5931\u4E86\u3002\n\u4F60\u51B3\u5B9A\u4E0D\u518D\u6361\u8D77\u6765\u5B83\u3002\n\u604D\u60DA\u4E2D\uFF0C\u4F60\u611F\u89C9\u5230\u4E00\u4E9B\u90AA\u5F02\u7684\u77E5\u8BC6\u6E9C\u8FDB\u4E86\u4F60\u7684\u5927\u8111\u3002"
