  eventName: "\u6F02\u6D6E\u7684\u7075\u9B42\u788E\u7247"
  eventContent: "\u4F60\u6CE8\u610F\u5230\u7A7A\u4E2D\u4F3C\u4E4E\u6709\u4EC0\u4E48\u4E1C\u897F\u5728\u6F02\u6D6E\u7740\u3002\n\u4F60\u9760\u8FD1\u4E00\u770B\uFF0C\u53D1\u73B0\u662F\u4E00\u5757\u534A\u900F\u660E\u7684\u7269\u4F53\uFF0C\u6B63\u5F53\u4F60\u7AEF\u8BE6\u65F6\uFF0C\u5B83\u5F00\u53E3\u8BF4\u8BDD\u4E86\uFF1A\u201C\u770B\u4EC0\u4E48\u770B\uFF0C\u6CA1\u89C1\u8FC7\u7075\u9B42\u5417\uFF1F\u201D\n\u4F60\u95EE\u5B83\u600E\u4E48\u4F1A\u53D8\u6210\u8FD9\u6837\u3002\n\u201C\u54EA\u6709\u4EC0\u4E48\u4E3A\u4EC0\u4E48\uFF0C\u6211\u5C31\u662F\u8FD9\u6837\u3002\u6211\u8BF4\uFF0C\u4F60\u628A\u6211\u8D85\u5EA6\u4E86\u5427\uFF0C\u6211\u73B0\u5728\u88AB\u56F0\u5728\u8FD9\u91CC\u4E86\u3002\u201D\n\u4F60\u51B3\u5B9A\u2026\u2026"
