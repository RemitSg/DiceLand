  eventContent: "\u4F60\u4EEC\u5728\u8DEF\u8FB9\u9047\u5230\u4E86\u4E00\u4F4D\u541F\u6E38\u8BD7\u4EBA\uFF0C\u4ED6\u9AD8\u6B4C\u7740\u4E0A\u6765\u548C\u4F60\u4EEC\u70ED\u60C5\u7684\u6500\u8C08\u8D77\u6765\uFF0C\u8FC7\u4E86\u4E00\u4F1A\u513F\u4ED6\u795E\u79D8\u516E\u516E\u5730\u95EE\uFF1A\u201C\u8981\u4E0D\u8981\u4E70\u4E2A\u7D27\u5F20\u53C8\u523A\u6FC0\u7684\u4E1C\u897F\uFF1F\u201D\n\u4F60\u51B3\u5B9A\u2026\u2026"
