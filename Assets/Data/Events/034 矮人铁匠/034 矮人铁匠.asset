  m_EditorClassIdentifier:
  eventId: 034
  eventName: "\u77EE\u4EBA\u94C1\u5320"
  eventContent: "\u4F60\u5FAA\u7740\u9524\u58F0\uFF0C\u627E\u5230\u8DEF\u8FB9\u4E00\u95F4\u77F3\u68DA\u3002\u4E00\u4E2A\u77EE\u4EBA\u6B63\u7528\u94C1\u94B3\u7FFB\u7089\u8FB9\u7684\u997C\u3002\u89C1\u4F60\u5728\u95E8\u53E3\u7AD9\u5B9A\uFF0C\u4ED6\u628A\u997C\u5F80\u91CC\u632A\u4E86\u632A\uFF0C\u8F6C\u8EAB\u628A\u94B3\u5B50\u653E\u5230\u4E86\u94C1\u7827\u4E0A\u3002\n\n\u300C\u7089\u706B\u8FD8\u591F\u7528\u4E00\u6B21\u7684\uFF0C\u60F3\u91CD\u94F8\u5565\uFF0C\u8FD9\u6B21\u7B97\u6211\u7684\u3002\u300D\n\n\u4F60\u51B3\u5B9A\u2026\u2026"
  eventIllustration: {fileID: 0}
  hideConsequences: 0
  options:
  - optionId: 1
    optionLabel: "\u91CD\u94F8\u4E00\u4E2A\u9057\u7269"
    requiredMoney: 0
    requiredMoneyPercent: 0
    consequenceDescription: "\u9009\u62E9\u4E00\u4E2A\u9057\u7269\uFF0C\u8F6C\u6362\u4E3A\u83B7\u5F97\u4E00\u4E2A\u540C\u54C1\u8D28\u9057\u7269"
    resultContent: "\u77EE\u4EBA\u5482\u5482\u5634\uFF0C\u7528\u94B3\u5B50\u6293\u8D77\u4F60\u7684\u65B0\u9057\u7269\u5305\u4E86\u8D77\u6765\uFF0C\u7136\u540E\u56DE\u5230\u4E86\u7089\u8FB9\u70E4\u997C\u3002"
    builtInEffectType: 23
    relicTable: {fileID: 11400000, guid: 6650ae7fed330b7408b1cad987b54259, type: 2}
