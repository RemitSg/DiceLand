  - optionId: 3
    optionLabel: "\u91CD\u94F8\u4E00\u4E2A\u6218\u5229\u54C1"
    requiredMoney: 0
    requiredMoneyPercent: 0
    consequenceDescription: "\u9009\u62E9\u4E00\u4E2A\u6218\u5229\u54C1\uFF0C\u8F6C\u6362\u4E3A\u83B7\u5F97\u4E00\u4E2A\u540C\u54C1\u8D28\u6218\u5229\u54C1"
    resultContent: "\u770B\u7740\u4F60\u9012\u4E0A\u6765\u7684\u5947\u5F62\u602A\u72B6\u7684\u6218\u5229\u54C1\uFF0C\u77EE\u4EBA\u53D1\u4E86\u6101\u4E00\u822C\u4E0D\u77E5\u9053\u4ECE\u4F55\u4E0B\u624B\u3002\n\n\u4E0D\u77E5\u72B9\u8C6B\u591A\u4E45\u540E\uFF0C\u7EC8\u4E8E\u94C6\u8DB3\u4E86\u52B2\u6572\u4E86\u4E00\u9524\u3002\n\n\u300C\u4E0D\u5BF9\u2026\u2026\u554A\uFF01\u4E0D\u5BF9\uFF01\u6211\u7684\u997C\uFF01\u300D\n\n\u4ED6\u8FDE\u5FD9\u56DE\u5230\u4E86\u7089\u8FB9\uFF0C\u53EA\u770B\u5230\u9ED1\u6210\u4E86\u70AD\u7684\u70E7\u997C\u3002\n\n\u4F60\u51B3\u5B9A\u5E26\u4E0A\u90A3\u4E2A\u534A\u6210\u54C1\u79BB\u5F00\u8FD9\u91CC\u3002"
