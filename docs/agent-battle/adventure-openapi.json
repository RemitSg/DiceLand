{
  "openapi": "3.0.3",
  "info": {
    "title": "DiceLand Agent Adventure API (B006b1)",
    "version": "0.8.0",
    "description": "Shared-rule adventure with terminal settlement, isolated ability progression and next runs. Full normal victory/earned-upgrade audit and complete save/replay remain pending."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8091"
    }
  ],
  "paths": {
    "/v1/command": {
      "post": {
        "operationId": "adventureCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentAdventureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command result; check success before reading state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentAdventureResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid command, stale revision or illegal action."
          },
          "500": {
            "description": "Execution error; observe or close the faulted session."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentAdventureRequest": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "format": "int32"
          },
          "y": {
            "type": "integer",
            "format": "int32"
          },
          "choiceIndex": {
            "type": "integer",
            "format": "int32",
            "description": "Choice index; run_set_ability uses 0 (disable) or 1 (enable), copied from legalActions."
          },
          "op": {
            "type": "string",
            "enum": [
              "create_run",
              "observe_run",
              "run_move",
              "run_interact",
              "run_battle",
              "run_return",
              "run_choose_calamity",
              "run_leave_location",
              "run_close",
              "run_buy",
              "run_refresh_shop",
              "run_craft",
              "run_rest_heal",
              "run_rest_restore_ap",
              "run_recruit",
              "run_equip",
              "run_open_reforge",
              "run_reforge_loot",
              "run_reforge_relic",
              "run_reforge_first",
              "run_reforge_second",
              "run_reforge_attribute",
              "run_reforge_reset",
              "run_reforge_confirm",
              "run_reforge_cancel",
              "run_reforge_finish",
              "run_choose_event",
              "run_continue_event",
              "run_choose_treasure",
              "run_choose_treasure_relic",
              "run_refresh_treasure_relics",
              "run_continue_treasure",
              "run_settle",
              "run_abandon",
              "run_next",
              "run_unlock_ability",
              "run_set_ability",
              "run_choose_starting_relic",
              "run_refresh_starting_relics"
            ],
            "description": "Copy an item from legalActions. run_next accepts an additional seed for the next run. Only map/battle phases expose abandon. Check dungeon.active and settlement.completed rather than optional object truthiness."
          },
          "battleAction": {
            "$ref": "./openapi.json#/components/schemas/AgentBattleLegalAction"
          },
          "sessionId": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Required for mutations; retries must preserve the entire command."
          },
          "revision": {
            "type": "integer",
            "default": -1,
            "description": "Latest outer adventure revision, required for mutations."
          },
          "seed": {
            "type": "integer",
            "default": 1,
            "description": "Signed 32-bit seed for create_run or run_next; next-run omission uses default 1. maxRounds is retained from the initial create_run."
          },
          "maxRounds": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "maximum": 1000
          },
          "assetId": {
            "type": "string",
            "description": "Asset GUID from legalActions: blueprint for crafting, weapon for equipment, material for reforge_first/second, or attribute for reforge_attribute. Ability commands use the node id in meta.nodes, not an asset GUID."
          },
          "profileId": {
            "type": "string",
            "description": "create_run only: omit/blank for disposable session progression. Explicit 1-64 letters/digits/underscore/hyphen selects isolated project-local Library/AgentAdventure/Profiles/<id>; Windows device names rejected. Never uses the player wallet/save. Persistent across close/reopen on the same host/project; deleting Library removes these test profiles."
          }
        }
      },
