{
  "openapi": "3.0.3",
  "info": {
    "title": "DiceLand Agent Adventure API (B005c)",
    "version": "0.7.0",
    "description": "Shared-rule normal adventure with map, battle, calamities, economy, rest, reforge, events, treasure and special dungeon traversal/return. Final settlement/meta and full save/replay remain upcoming batches."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8091"
    }
  ],
  "paths": {
    "/v1/command": {
      "post": {
        "operationId": "adventureCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentAdventureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command result; check success before reading state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentAdventureResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid command, stale revision or illegal action."
          },
          "500": {
            "description": "Execution error; observe or close the faulted session."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
