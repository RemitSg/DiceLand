{
  "openapi": "3.0.3",
  "info": {
    "title": "DiceLand Agent Adventure API (B004b2)",
    "version": "0.4.0",
    "description": "Shared-rule normal adventure including map, calamities, battles, merchant, forge, rest, recruits, equipment and staged loot/relic reforge. Events/treasure/subdungeons, final settlement and full save/replay remain upcoming batches."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8091"
    }
  ],
  "paths": {
    "/v1/command": {
      "post": {
        "operationId": "adventureCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentAdventureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command result; check success before reading state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentAdventureResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid command, stale revision or illegal action."
          },
          "500": {
            "description": "Execution error; observe or close the faulted session."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentAdventureRequest": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "format": "int32"
          },
          "y": {
            "type": "integer",
            "format": "int32"
          },
          "choiceIndex": {
            "type": "integer",
            "format": "int32"
          },
          "op": {
            "type": "string",
            "enum": [
              "create_run",
              "observe_run",
              "run_move",
              "run_interact",
              "run_battle",
              "run_return",
              "run_choose_calamity",
              "run_leave_location",
              "run_close",
              "run_buy",
              "run_refresh_shop",
              "run_craft",
              "run_rest_heal",
              "run_rest_restore_ap",
              "run_recruit",
              "run_equip",
              "run_open_reforge",
              "run_reforge_loot",
              "run_reforge_relic",
              "run_reforge_first",
              "run_reforge_second",
              "run_reforge_attribute",
              "run_reforge_reset",
              "run_reforge_confirm",
              "run_reforge_cancel",
              "run_reforge_finish"
            ]
          },
          "battleAction": {
            "$ref": "./openapi.json#/components/schemas/AgentBattleLegalAction"
          },
          "sessionId": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Required for mutations; retries must preserve the entire command."
          },
          "revision": {
            "type": "integer",
            "default": -1,
            "description": "Latest outer adventure revision, required for mutations."
          },
          "seed": {
            "type": "integer",
            "default": 1
          },
          "maxRounds": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "maximum": 1000
          },
          "assetId": {
            "type": "string",
            "description": "Asset GUID from legalActions: blueprint for crafting, weapon for equipment, material for reforge_first/second, or attribute for reforge_attribute."
          }
        }
      },
      "AgentAdventureAction": {
