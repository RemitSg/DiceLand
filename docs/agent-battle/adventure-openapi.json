            "format": "int32"
          },
          "choiceIndex": {
            "type": "integer",
            "format": "int32"
          },
          "op": {
            "type": "string",
            "enum": [
              "create_run",
              "observe_run",
              "run_move",
              "run_interact",
              "run_battle",
              "run_return",
              "run_choose_calamity",
              "run_leave_location",
              "run_close",
              "run_buy",
              "run_refresh_shop",
              "run_craft",
              "run_rest_heal",
              "run_rest_restore_ap",
              "run_recruit",
              "run_equip",
              "run_open_reforge",
              "run_reforge_loot",
              "run_reforge_relic",
              "run_reforge_first",
              "run_reforge_second",
              "run_reforge_attribute",
              "run_reforge_reset",
              "run_reforge_confirm",
              "run_reforge_cancel",
              "run_reforge_finish",
              "run_choose_event",
              "run_continue_event",
              "run_choose_treasure",
              "run_choose_treasure_relic",
              "run_refresh_treasure_relics",
              "run_continue_treasure"
            ],
            "description": "Copy an item from legalActions. Events, treasure and special dungeon entry/exit use their normal choice, continue and move actions. Check dungeon.active to distinguish the linear dungeon board."
          },
          "battleAction": {
            "$ref": "./openapi.json#/components/schemas/AgentBattleLegalAction"
          },
          "sessionId": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Required for mutations; retries must preserve the entire command."
          },
          "revision": {
            "type": "integer",
            "default": -1,
            "description": "Latest outer adventure revision, required for mutations."
          },
          "seed": {
            "type": "integer",
            "default": 1
          },
          "maxRounds": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "maximum": 1000
          },
          "assetId": {
            "type": "string",
            "description": "Asset GUID from legalActions: blueprint for crafting, weapon for equipment, material for reforge_first/second, or attribute for reforge_attribute."
          }
        }
      },
